+uint32_t
+FrameExchangeManager::GetNpcaIcrSize()
+{
+    CtrlBAckResponseHeader ba;
+    ba.SetType({BlockAckType::MULTI_STA, {0}});
+    ba.SetAckType(true, 0);
+    ba.SetTidInfo(ICR_CONTEXT_TID, 0);
+    WifiMacHeader hdr;
+    hdr.SetType(WIFI_MAC_CTL_BACKRESP);
+    return hdr.GetSize() + ba.GetSerializedSize() + WIFI_MAC_FCS_LENGTH;
+}
+
+CtrlTriggerHeader
+FrameExchangeManager::GetNpcaBsrpNtb(MHz_u width)
+{
+    CtrlTriggerHeader trigger;
+    trigger.SetType(TriggerFrameType::BSRP_TRIGGER);
+    trigger.SetVariant(TriggerFrameVariant::EHT);
+    trigger.SetBsrpNtb();
+    trigger.SetUlBandwidth(width);
+    // UL Length: the even value of the L-SIG LENGTH of the response non-HT (duplicate) PPDU
+    // carrying the Multi-STA BlockAck frame in ICR context (37.7.4)
+    const auto icrSize = GetNpcaIcrSize();
+    trigger.SetUlLength(static_cast<uint16_t>(icrSize + (icrSize % 2)));
+    trigger.SetCsRequired(true);
+    trigger.SetNpcaPrimaryChannelIndication(true);
+    // the User Info field is addressed to the associated AP (AID12 = 0); its other fields
+    // are reserved
+    auto& userInfo = trigger.AddUserInfoField();
+    userInfo.SetAid12(0);
+    return trigger;
+}
+
+bool
+FrameExchangeManager::IsNpcaIcr(Ptr<const WifiMpdu> mpdu) const
+{
+    const auto& hdr = mpdu->GetHeader();
+    if (!hdr.IsBlockAck() || !m_staMac || hdr.GetAddr1() != m_self)
+    {
+        return false;
+    }
+    CtrlBAckResponseHeader ba;
+    mpdu->GetPacket()->PeekHeader(ba);
+    return ba.IsMultiSta() && ba.GetNPerAidTidInfoSubfields() >= 1 && ba.GetAckType(0) &&
+           ba.GetTidInfo(0) == ICR_CONTEXT_TID && ba.GetAid11(0) == m_staMac->GetAssociationId();
+}
+
+uint32_t
+FrameExchangeManager::GetNpcaBsrpNtbSize(MHz_u width)
+{
+    WifiMacHeader hdr;
+    hdr.SetType(WIFI_MAC_CTL_TRIGGER);
+    return hdr.GetSize() + GetNpcaBsrpNtb(width).GetSerializedSize() + WIFI_MAC_FCS_LENGTH;
+}
