+/**
+ * @ingroup wifi-test
+ * UHR Operation element (IEEE P802.11bn D2.0, 9.4.2.360) serialization.
+ */
+class UhrOperationElementTest : public HeaderSerializationTestCase
+{
+  public:
+    UhrOperationElementTest()
+        : HeaderSerializationTestCase("UHR Operation element (NPCA) serialization")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        // Beacon frame: NPCA Enabled only, no NPCA Operation Parameters field
+        UhrOperation beacon;
+        beacon.m_npcaEnabled = true;
+        TestHeaderSerialization(beacon);
+        NS_TEST_EXPECT_MSG_EQ(beacon.GetSerializedSize(), 2 + 1 + 2, "Beacon variant size");
+
+        UhrOperation op;
+        op.m_npcaEnabled = true;
+        UhrOperation::NpcaOperationParameters p;
+        p.primaryChannel = 44;
+        p.minDurationThreshold = 3;
+        p.switchingDelay = 25;     // 100 us
+        p.switchingBackDelay = 4;  // 16 us
+        p.initialQsrc = 2;
+        p.moplen = false;
+        op.m_npcaParams = p;
+        TestHeaderSerialization(op);
+        NS_TEST_EXPECT_MSG_EQ(op.GetSerializedSize(), 2 + 1 + 2 + 4, "size without bitmap");
+        op.m_npcaParams->disabledSubchannelBitmap = 0x0009;
+        TestHeaderSerialization(op);
+        NS_TEST_EXPECT_MSG_EQ(op.GetSerializedSize(), 2 + 1 + 2 + 6, "size with bitmap");
+
+        Buffer buffer;
+        buffer.AddAtStart(op.GetSerializedSize());
+        op.Serialize(buffer.Begin());
+        auto it = buffer.Begin();
+        NS_TEST_EXPECT_MSG_EQ(+it.ReadU8(), 255, "Element ID");
+        it.ReadU8(); // length
+        NS_TEST_EXPECT_MSG_EQ(+it.ReadU8(), 151, "Element ID Extension");
+        const auto control = it.ReadU16();
+        NS_TEST_EXPECT_MSG_EQ(((control >> 1) & 1), 1, "NPCA Enabled (B1)");
+        NS_TEST_EXPECT_MSG_EQ(((control >> 10) & 1), 1, "NPCA Operation Parameters Present (B10)");
+        const auto params = it.ReadU32();
+        NS_TEST_EXPECT_MSG_EQ((params & 0xff), 44, "NPCA Primary Channel (B0-B7)");
+        NS_TEST_EXPECT_MSG_EQ(((params >> 8) & 0xf), 3, "Minimum Duration Threshold (B8-B11)");
+        NS_TEST_EXPECT_MSG_EQ(((params >> 12) & 0x3f), 25, "Switching Delay (B12-B17)");
+        NS_TEST_EXPECT_MSG_EQ(((params >> 18) & 0x3f), 4, "Switching Back Delay (B18-B23)");
+        NS_TEST_EXPECT_MSG_EQ(((params >> 24) & 0x3), 2, "Initial NPCA QSRC (B24-B25)");
+        NS_TEST_EXPECT_MSG_EQ(((params >> 27) & 0x1), 1, "Bitmap Present (B27)");
+        NS_TEST_EXPECT_MSG_EQ(it.ReadU16(), 0x0009, "NPCA Disabled Subchannel Bitmap");
+
+        UhrOperation rx;
+        rx.Deserialize(buffer.Begin());
+        NS_TEST_ASSERT_MSG_EQ(rx.m_npcaParams.has_value(), true, "parameters present");
+        NS_TEST_EXPECT_MSG_EQ(rx.m_npcaParams->GetMinDurationUs(), 512 + 3 * 128, "min duration");
+        NS_TEST_EXPECT_MSG_EQ(+rx.m_npcaParams->initialQsrc, 2, "Initial NPCA QSRC");
+    }
+};
