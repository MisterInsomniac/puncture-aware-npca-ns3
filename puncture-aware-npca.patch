new file mode 100644
index 0000000..c566718
--- /dev/null
+++ b/src/npca/model/npca-dcf-simulation.h
@@ -0,0 +1,180 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#ifndef NPCA_DCF_SIMULATION_H
+#define NPCA_DCF_SIMULATION_H
+
+#include "npca-channel-selector.h"
+#include "npca-obss-source.h"
+
+#include "ns3/event-id.h"
+#include "ns3/nstime.h"
+#include "ns3/object.h"
+#include "ns3/random-variable-stream.h"
+#include "ns3/traced-callback.h"
+
+#include <vector>
+
+namespace ns3
+{
+
+/**
+ * @ingroup npca
+ * How the NPCA primary channel is placed.
+ */
+enum class NpcaPrimaryPlacement : uint8_t
+{
+    FIXED = 0, //!< the configured unp
+    INFORMED,  //!< puncture-informed selection learned at the start of the run (Sec. IV-C)
+    FLEXIBLE,  //!< idealized: any unit may serve as NPCA primary, per PPDU (upper bound)
+};
+
+/**
+ * @ingroup npca
+ * Output of one run.
+ */
+struct NpcaSimResults
+{
+    double throughput{0};      //!< normalized throughput (fraction of time with payload,
+                               //!< weighted by units/U if WeightByUnits)
+    double meanAccessDelayMs{0}; //!< mean MAC access delay (head-of-line to ACK)
+    uint64_t successes{0};       //!< successful transmissions
+    uint64_t collisions{0};      //!< collided transmissions
+    uint64_t npcaSuccesses{0};   //!< successful transmissions on the NPCA channel
+    uint64_t obssPpdus{0};       //!< OBSS PPDUs seen
+    uint64_t npcaEligiblePpdus{0}; //!< OBSS PPDUs for which C was non-empty
+    int npcaPrimary{-1};         //!< NPCA primary in use at the end of the run
+};
+
+/**
+ * @ingroup npca
+ * Event-driven simulation of n saturated BSS-A stations running binary-exponential-backoff
+ * DCF in one collision domain, facing exogenous OBSS traffic on their primary channel
+ * (Section V of the paper).
+ *
+ * While an OBSS PPDU occupies the primary channel, the stations run Algorithm 1
+ * (NpcaChannelSelector). If C is non-empty they may contend on C only T_NPCA after the
+ * OBSS PPDU starts (plus DIFS), and may start a frame exchange only if it ends at least
+ * T_SW before the OBSS PPDU ends (switching delay and NPCA timer of D2.0). Otherwise all
+ * backoff counters freeze until the primary becomes idle.
+ */
+class NpcaDcfSimulation : public Object
+{
+  public:
+    /**
+     * @brief Get the type ID.
+     * @return the object TypeId
+     */
+    static TypeId GetTypeId();
+
+    NpcaDcfSimulation();
+    ~NpcaDcfSimulation() override;
+
+    /// @return the channel selector (configure it before Run())
+    Ptr<NpcaChannelSelector> GetSelector() const;
+    /// @return the OBSS source (configure it before Run())
+    Ptr<NpcaObssSource> GetObssSource() const;
+
+    /**
+     * Assign fixed random variable streams. The OBSS uses the first streams so that
+     * all schemes see the same OBSS timeline.
+     * @param stream first stream index
+     * @return the number of streams used
+     */
+    int64_t AssignStreams(int64_t stream);
+
+    /**
+     * Run the simulation (calls Simulator::Run(); the caller calls Simulator::Destroy()).
+     * @return the results
+     */
+    NpcaSimResults Run();
+
+    /**
+     * TracedCallback signature for frame exchanges.
+     * @param start start time
+     * @param channel units used
+     * @param success whether the exchange succeeded
+     */
+    typedef void (*TxTracedCallback)(Time start, UnitSet channel, bool success);
+
+  protected:
+    void DoDispose() override;
+
+  private:
+    /// Medium state seen by BSS-A
+    enum ChannelState
+    {
+        ON_PRIMARY,
+        ON_NPCA,
+        FROZEN
+    };
+
+    void ScheduleNextObss();
+    void OnObssStart(NpcaObssPpdu ppdu);
+    void OnObssEnd();
+    void EnterNpca(Time freeAt);
+    void StartCounting(Time t0);
+    void Interrupt(Time t);
+    void TxStart();
+    void TxEnd(std::vector<uint32_t> winners, UnitSet channel);
+    void EndLearning();
+    uint32_t MinBackoff() const;
+    uint32_t DrawBackoff(uint32_t cw);
+    Time ExchangeDuration(double eta) const;
+
+    Ptr<NpcaChannelSelector> m_selector; //!< Algorithm 1
+    Ptr<NpcaObssSource> m_obss;          //!< OBSS timeline
+    Ptr<UniformRandomVariable> m_rng;    //!< backoff draws
+
+    // configuration
+    uint32_t m_n;          //!< number of stations
+    Time m_slot;           //!< sigma
+    Time m_sifs;           //!< SIFS
+    Time m_difs;           //!< DIFS
+    Time m_ack;            //!< ACK duration
+    uint32_t m_cwMin;      //!< CWmin
+    uint32_t m_cwMax;      //!< CWmax
+    Time m_tNpca;          //!< NPCA switching delay
+    Time m_tSw;            //!< switch-back delay (NPCA timer margin)
+    Time m_payload;        //!< payload airtime (at eta = 1)
+    Time m_duration;       //!< simulated time
+    bool m_weightByUnits;  //!< weight throughput by units / U
+    bool m_difsAfterSwitch; //!< DIFS on the NPCA channel after switching
+    bool m_obssCorruptsTx; //!< an OBSS PPDU starting during a BSS-A exchange corrupts it
+    NpcaPrimaryPlacement m_placement; //!< NPCA primary placement
+    double m_learningFraction;        //!< learning window for INFORMED
+    int m_candFirst;                  //!< first candidate unp (-1 auto: U/2)
+    int m_candLast;                   //!< last candidate unp (-1 auto: U-1)
+
+    // state
+    std::vector<uint32_t> m_backoff; //!< per-station backoff counters
+    std::vector<uint32_t> m_cw;      //!< per-station CW
+    std::vector<Time> m_hol;         //!< head-of-line times
+    ChannelState m_state;            //!< current channel
+    bool m_counting;                 //!< backoff countdown in progress
+    Time m_countStart;               //!< when the countdown started
+    Time m_cap;                      //!< latest countdown instant usable on NPCA
+    EventId m_txEvent;               //!< pending TxStart
+    bool m_txBusy;                   //!< a frame exchange is in progress
+    bool m_txOnNpca;                 //!< ... on the NPCA channel
+    bool m_txCorrupted;              //!< ... and was hit by an OBSS start
+    bool m_obssActive;               //!< an OBSS PPDU is on the primary
+    NpcaObssPpdu m_cur;              //!< current OBSS PPDU
+    NpcaSelection m_sel;             //!< current NPCA selection
+    bool m_learning;                 //!< in the INFORMED learning window
+    std::vector<NpcaObssPpdu> m_observed; //!< PPDUs observed while learning
+
+    // statistics
+    double m_payloadUnitTimeUs; //!< sum of payload airtime x weight
+    double m_delaySumUs;        //!< sum of access delays
+    NpcaSimResults m_res;       //!< results
+
+    TracedCallback<Time, UnitSet, bool> m_txTrace; //!< frame-exchange trace
+};
+
+} // namespace ns3
+
+#endif /* NPCA_DCF_SIMULATION_H */
diff --git a/src/npca/model/npca-obss-source.cc b/src/npca/model/npca-obss-source.cc
new file mode 100644
index 0000000..c998c34
--- /dev/null
+++ b/src/npca/model/npca-obss-source.cc
@@ -0,0 +1,219 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include "npca-obss-source.h"
+
+#include "ns3/abort.h"
+#include "ns3/double.h"
+#include "ns3/integer.h"
+#include "ns3/log.h"
+#include "ns3/string.h"
+#include "ns3/uinteger.h"
+
+#include <cmath>
+#include <sstream>
+
+namespace ns3
+{
+
+NS_LOG_COMPONENT_DEFINE("NpcaObssSource");
+NS_OBJECT_ENSURE_REGISTERED(NpcaObssSource);
+
+TypeId
+NpcaObssSource::GetTypeId()
+{
+    static TypeId tid =
+        TypeId("ns3::NpcaObssSource")
+            .SetParent<Object>()
+            .SetGroupName("Npca")
+            .AddConstructor<NpcaObssSource>()
+            .AddAttribute("DutyCycle",
+                          "OBSS duty cycle rho on BSS-A's primary channel (ignored if NumAps > 0).",
+                          DoubleValue(0.5),
+                          MakeDoubleAccessor(&NpcaObssSource::m_dutyCycle),
+                          MakeDoubleChecker<double>(0.0, 0.999))
+            .AddAttribute("MeanOnDuration",
+                          "Mean (exponential) OBSS PPDU duration.",
+                          TimeValue(MicroSeconds(3600)),
+                          MakeTimeAccessor(&NpcaObssSource::m_meanOn),
+                          MakeTimeChecker())
+            .AddAttribute("WidthDistribution",
+                          "OBSS PPDU widths in 20 MHz units and probabilities, 'w:p,w:p,...'.",
+                          StringValue("1:0.15,2:0.25,4:0.6"),
+                          MakeStringAccessor(&NpcaObssSource::SetWidthDistribution),
+                          MakeStringChecker())
+            .AddAttribute("PuncturingProbability",
+                          "Puncturing prevalence pi (or ppunc when TargetedUnit >= 0).",
+                          DoubleValue(0.3),
+                          MakeDoubleAccessor(&NpcaObssSource::m_pi),
+                          MakeDoubleChecker<double>(0.0, 1.0))
+            .AddAttribute("IdleProbability",
+                          "Probability q that a punctured block is idle at BSS-A.",
+                          DoubleValue(0.8),
+                          MakeDoubleAccessor(&NpcaObssSource::m_q),
+                          MakeDoubleChecker<double>(0.0, 1.0))
+            .AddAttribute("TargetedUnit",
+                          "If >= 0, 80 MHz PPDUs puncture exactly this unit with probability "
+                          "PuncturingProbability (single-channel scenario of Sec. V-A).",
+                          IntegerValue(-1),
+                          MakeIntegerAccessor(&NpcaObssSource::m_targetedUnit),
+                          MakeIntegerChecker<int>(-1, 15))
+            .AddAttribute("NumAps",
+                          "Number K of CSMA-coupled OBSS APs (0: single OBSS with DutyCycle).",
+                          UintegerValue(0),
+                          MakeUintegerAccessor(&NpcaObssSource::m_numAps),
+                          MakeUintegerChecker<uint32_t>())
+            .AddAttribute("PerApLoad",
+                          "Load of each OBSS AP when NumAps > 0.",
+                          DoubleValue(0.2),
+                          MakeDoubleAccessor(&NpcaObssSource::m_perApLoad),
+                          MakeDoubleChecker<double>(0.0, 0.999));
+    return tid;
+}
+
+NpcaObssSource::NpcaObssSource()
+    : m_dutyCycle(0.5),
+      m_meanOn(MicroSeconds(3600)),
+      m_pi(0.3),
+      m_q(0.8),
+      m_targetedUnit(-1),
+      m_numAps(0),
+      m_perApLoad(0.2),
+      m_lastEnd(Seconds(0))
+{
+    m_on = CreateObject<ExponentialRandomVariable>();
+    m_off = CreateObject<ExponentialRandomVariable>();
+    m_width = CreateObject<UniformRandomVariable>();
+    m_punct = CreateObject<UniformRandomVariable>();
+    m_pattern = CreateObject<UniformRandomVariable>();
+    m_idle = CreateObject<UniformRandomVariable>();
+    m_ap = CreateObject<UniformRandomVariable>();
+}
+
+NpcaObssSource::~NpcaObssSource() = default;
+
+void
+NpcaObssSource::DoInitialize()
+{
+    Object::DoInitialize();
+}
+
+int64_t
+NpcaObssSource::AssignStreams(int64_t stream)
+{
+    m_on->SetStream(stream);
+    m_off->SetStream(stream + 1);
+    m_width->SetStream(stream + 2);
+    m_punct->SetStream(stream + 3);
+    m_pattern->SetStream(stream + 4);
+    m_idle->SetStream(stream + 5);
+    m_ap->SetStream(stream + 6);
+    return 7;
+}
+
+void
+NpcaObssSource::SetWidthDistribution(const std::string& dist)
+{
+    m_widthDistStr = dist;
+    m_widthDist.clear();
+    std::istringstream iss(dist);
+    std::string item;
+    double total = 0;
+    while (std::getline(iss, item, ','))
+    {
+        auto pos = item.find(':');
+        NS_ABORT_MSG_IF(pos == std::string::npos, "Bad width distribution item: " << item);
+        auto w = static_cast<uint8_t>(std::stoi(item.substr(0, pos)));
+        double p = std::stod(item.substr(pos + 1));
+        NS_ABORT_MSG_IF(w != 1 && w != 2 && w != 4 && w != 8 && w != 16,
+                        "OBSS width must be 1,2,4,8,16 units");
+        m_widthDist.emplace_back(w, p);
+        total += p;
+    }
+    NS_ABORT_MSG_IF(m_widthDist.empty() || std::abs(total - 1.0) > 1e-6,
+                    "Width probabilities must sum to 1: " << dist);
+}
+
+const std::vector<std::pair<uint8_t, double>>&
+NpcaObssSource::GetWidthDistribution() const
+{
+    return m_widthDist;
+}
+
+double
+NpcaObssSource::GetEffectiveDutyCycle() const
+{
+    if (m_numAps > 0)
+    {
+        return 1.0 - std::pow(1.0 - m_perApLoad, static_cast<double>(m_numAps));
+    }
+    return m_dutyCycle;
+}
+
+NpcaObssPpdu
+NpcaObssSource::Next()
+{
+    const double rho = GetEffectiveDutyCycle();
+    const double meanOnUs = m_meanOn.GetMicroSeconds();
+    const double meanOffUs = rho > 0 ? meanOnUs * (1.0 - rho) / rho : 1e15;
+
+    NpcaObssPpdu ppdu;
+    // Draw every variable every time so that the stream positions do not depend on outcomes
+    double offUs = m_off->GetValue(meanOffUs, 0);
+    double onUs = m_on->GetValue(meanOnUs, 0);
+    double uWidth = m_width->GetValue();
+    double uPunct = m_punct->GetValue();
+    double uPattern = m_pattern->GetValue();
+    double uIdle[2] = {m_idle->GetValue(), m_idle->GetValue()};
+    double uAp = m_ap->GetValue();
+
+    ppdu.start = m_lastEnd + NanoSeconds(static_cast<int64_t>(std::llround(offUs * 1e3)));
+    ppdu.end = ppdu.start + NanoSeconds(std::max<int64_t>(1, std::llround(onUs * 1e3)));
+    m_lastEnd = ppdu.end;
+    ppdu.apId = (m_numAps > 0) ? std::min<uint32_t>(m_numAps - 1, uAp * m_numAps) : 0;
+
+    double acc = 0;
+    ppdu.widthUnits = m_widthDist.back().first;
+    for (const auto& [w, p] : m_widthDist)
+    {
+        acc += p;
+        if (uWidth < acc)
+        {
+            ppdu.widthUnits = w;
+            break;
+        }
+    }
+    ppdu.rx.nominal = NpcaChannelSets::Range(0, ppdu.widthUnits);
+
+    if (uPunct < m_pi && ppdu.widthUnits >= 4)
+    {
+        if (m_targetedUnit >= 0)
+        {
+            if (ppdu.widthUnits == 4 && m_targetedUnit > 0 && m_targetedUnit < 4)
+            {
+                UnitSet b = NpcaChannelSets::Range(m_targetedUnit, 1);
+                ppdu.pattern = {b, {b}};
+            }
+        }
+        else
+        {
+            auto patterns = NpcaChannelSets::GetPuncturingPatterns(ppdu.widthUnits, 0, 0);
+            auto idx = std::min<size_t>(patterns.size() - 1, uPattern * patterns.size());
+            ppdu.pattern = patterns[idx];
+        }
+    }
+    ppdu.rx.punctured = ppdu.pattern.punctured;
+    for (size_t i = 0; i < ppdu.pattern.blocks.size(); ++i)
+    {
+        if (uIdle[i] >= m_q)
+        {
+            ppdu.busyPunctured |= ppdu.pattern.blocks[i];
+        }
+    }
+    return ppdu;
+}
+
+} // namespace ns3
