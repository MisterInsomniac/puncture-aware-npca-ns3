+void
+Txop::StartNpcaBackoff(uint8_t linkId, uint8_t initialQsrc)
+{
+    NS_LOG_FUNCTION(this << +linkId << +initialQsrc);
+    auto& link = GetLink(linkId);
+    if (!link.npcaInitialQsrc.has_value())
+    {
+        link.npcaSavedBackoffSlots = link.backoffSlots;
+        link.npcaSavedCw = link.cw;
+        link.npcaSavedQsrc = link.staRetryCount;
+    }
+    link.npcaInitialQsrc = initialQsrc;
+    link.staRetryCount = initialQsrc;
+    link.cw = std::min(GetMaxCw(linkId), (1U << initialQsrc) * (GetMinCw(linkId) + 1) - 1);
+    m_cwTrace(link.cw, linkId);
+    // invoke the backoff procedure even if the medium is not busy
+    GenerateBackoff(linkId);
