+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#ifndef NPCA_OBSS_SOURCE_H
+#define NPCA_OBSS_SOURCE_H
+
+#include "npca-channel-selector.h"
+
+#include "ns3/nstime.h"
+#include "ns3/object.h"
+#include "ns3/random-variable-stream.h"
+
+#include <vector>
+
+namespace ns3
+{
+
+/**
+ * @ingroup npca
+ * One OBSS PPDU on BSS-A's primary channel, as generated by NpcaObssSource.
+ */
+struct NpcaObssPpdu
+{
+    Time start;              //!< start of the PPDU
+    Time end;                //!< end of the PPDU
+    uint8_t widthUnits{1};   //!< W
+    uint32_t apId{0};        //!< transmitting OBSS AP
+    NpcaCausalPpdu rx;       //!< RXVECTOR view at BSS-A (N, P, ...)
+    PuncturingPattern pattern; //!< puncturing pattern (empty if not punctured)
+    UnitSet busyPunctured{0};  //!< punctured units that are busy (cause of puncturing heard)
+
+    /// @param bssUnits U
+    /// @return I, the units that pass per-unit CCA at BSS-A
+    UnitSet CcaIdle(uint8_t bssUnits) const
+    {
+        UnitSet occupied = rx.nominal & ~rx.punctured;
+        return NpcaChannelSets::Range(0, bssUnits) & ~occupied & ~busyPunctured;
+    }
+};
+
+/**
+ * @ingroup npca
+ * Exogenous OBSS traffic on BSS-A's primary channel (Section V): exponential ON/OFF with
+ * duty cycle rho, PPDU widths drawn from P(W) (all starting at unit 0), each PPDU punctured
+ * with probability pi using a pattern drawn uniformly from the allowed 802.11be patterns that
+ * keep unit 0, and each punctured block independently idle with probability q.
+ *
+ * With NumAps = K > 0, K CSMA-coupled OBSS APs of load PerApLoad each are emulated: their
+ * PPDUs do not overlap and the aggregate occupancy is 1 - (1 - load)^K. Because ON and OFF
+ * periods are exponential, this is equivalent to a single aggregate ON/OFF process whose PPDUs
+ * are attributed uniformly to the K APs.
+ *
+ * All draws use dedicated streams so that every scheme sees the same OBSS timeline
+ * (common random numbers).
+ */
+class NpcaObssSource : public Object
+{
+  public:
+    /**
+     * @brief Get the type ID.
+     * @return the object TypeId
+     */
+    static TypeId GetTypeId();
+
+    NpcaObssSource();
+    ~NpcaObssSource() override;
+
+    /**
+     * Assign fixed random variable streams.
+     * @param stream first stream index
+     * @return the number of streams used
+     */
+    int64_t AssignStreams(int64_t stream);
+
+    /**
+     * Generate the next PPDU of the timeline (the first one starts after an OFF period
+     * that begins at time zero).
+     * @return the PPDU
+     */
+    NpcaObssPpdu Next();
+
+    /// @return the effective (aggregate) duty cycle
+    double GetEffectiveDutyCycle() const;
+
+    /// @param dist width distribution, e.g. "1:0.15,2:0.25,4:0.6" (units:probability)
+    void SetWidthDistribution(const std::string& dist);
+    /// @return the parsed width distribution
+    const std::vector<std::pair<uint8_t, double>>& GetWidthDistribution() const;
+
+  protected:
+    void DoInitialize() override;
+
+  private:
+    double m_dutyCycle;            //!< rho (single OBSS)
+    Time m_meanOn;                 //!< mean ON (PPDU) duration
+    std::string m_widthDistStr;    //!< width distribution string
+    double m_pi;                   //!< puncturing prevalence / ppunc
+    double m_q;                    //!< P(punctured block idle)
+    int m_targetedUnit;            //!< if >= 0: only this unit is ever punctured (base scenario)
+    uint32_t m_numAps;             //!< K (0 = single OBSS with DutyCycle)
+    double m_perApLoad;            //!< load per OBSS AP
+    std::vector<std::pair<uint8_t, double>> m_widthDist; //!< parsed P(W)
+    Time m_lastEnd;                //!< end of the last generated PPDU
+
+    Ptr<ExponentialRandomVariable> m_on;   //!< ON durations
+    Ptr<ExponentialRandomVariable> m_off;  //!< OFF durations
+    Ptr<UniformRandomVariable> m_width;    //!< width draw
+    Ptr<UniformRandomVariable> m_punct;    //!< punctured? and pattern draw
+    Ptr<UniformRandomVariable> m_pattern;  //!< pattern index
+    Ptr<UniformRandomVariable> m_idle;     //!< block idleness
+    Ptr<UniformRandomVariable> m_ap;       //!< AP attribution
+};
+
+} // namespace ns3
+
+#endif /* NPCA_OBSS_SOURCE_H */
