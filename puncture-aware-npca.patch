+
+using namespace ns3;
+
+/**
+ * @ingroup npca-tests
+ * 802.11be puncturing patterns and the compliant family T.
+ */
+class NpcaChannelSetsTestCase : public TestCase
+{
+  public:
+    NpcaChannelSetsTestCase()
+        : TestCase("802.11be puncturing patterns and compliant set family")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        using S = NpcaChannelSets;
+        // Section III-B: excluding patterns that puncture unit 0 leaves 3, 10 and 15
+        NS_TEST_EXPECT_MSG_EQ(S::GetPuncturingPatterns(4, 0, 0).size(), 3, "80 MHz");
+        NS_TEST_EXPECT_MSG_EQ(S::GetPuncturingPatterns(8, 0, 0).size(), 10, "160 MHz");
+        NS_TEST_EXPECT_MSG_EQ(S::GetPuncturingPatterns(16, 0, 0).size(), 15, "320 MHz");
+        NS_TEST_EXPECT_MSG_EQ(S::GetPuncturingPatterns(16, 0, -1).size(), 24, "320 MHz all");
+        // Section III-A: 95 compliant sets for U = 16
+        NS_TEST_EXPECT_MSG_EQ(S::GetCompliantSets(16).size(), 95, "|T| for U=16");
+        NS_TEST_EXPECT_MSG_EQ(S::GetCompliantSets(4).size(), 11, "|T| for U=4");
+        // Section IV-C: unit 12 punctured in 7 of 15 patterns, unit 8 in 3 of 15
+        int c12 = 0;
+        int c8 = 0;
+        int maxBlocks = 0;
+        for (const auto& p : S::GetPuncturingPatterns(16, 0, 0))
+        {
+            c12 += S::Contains(p.punctured, 12);
+            c8 += S::Contains(p.punctured, 8);
+            maxBlocks = std::max<int>(maxBlocks, p.blocks.size());
+        }
+        NS_TEST_EXPECT_MSG_EQ(c12, 7, "unit 12");
+        NS_TEST_EXPECT_MSG_EQ(c8, 3, "unit 8");
+        NS_TEST_EXPECT_MSG_EQ(maxBlocks, 2, "up to 4 idle outcomes per pattern");
+        // largest compliant set
+        NS_TEST_EXPECT_MSG_EQ(S::LargestCompliantSet(S::Range(8, 8), 8, 16), S::Range(8, 8), "");
+        NS_TEST_EXPECT_MSG_EQ(S::LargestCompliantSet(S::Range(6, 10), 8, 16),
+                              S::Range(6, 10),
+                              "80+40 pattern");
+        NS_TEST_EXPECT_MSG_EQ(S::LargestCompliantSet(S::Range(5, 11), 8, 16),
+                              S::Range(6, 10),
+                              "an extra 20 MHz cannot be added");
+        NS_TEST_EXPECT_MSG_EQ(S::LargestCompliantSet(S::Range(9, 7), 8, 16), 0, "unp not in A");
+    }
+};
+
+/**
+ * @ingroup npca-tests
+ * Algorithm 1.
+ */
+class NpcaSelectorTestCase : public TestCase
+{
+  public:
+    NpcaSelectorTestCase()
+        : TestCase("Puncture-aware NPCA channel selection (Algorithm 1)")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        using S = NpcaChannelSets;
+        auto sel = CreateObject<NpcaChannelSelector>();
+        sel->SetAttribute("BssUnits", UintegerValue(4));
+        sel->SetAttribute("NpcaPrimary", IntegerValue(2));
+        sel->SetAttribute("Eta1", DoubleValue(0.89));
+        sel->SetAttribute("Eta2", DoubleValue(0.80));
+
+        // Fig. 1: OBSS spans ch0-ch3, punctures ch2
+        NpcaCausalPpdu ppdu;
+        ppdu.nominal = S::Range(0, 4);
+        ppdu.punctured = S::Range(2, 1);
+        UnitSet idle = S::Range(2, 1);
+
+        sel->SetScheme(NpcaScheme::STANDARD);
+        NS_TEST_EXPECT_MSG_EQ(sel->Select(ppdu, idle).IsUsable(), false, "D2.0 rejects ch2");
+        sel->SetScheme(NpcaScheme::PUNCTURE_AWARE);
+        auto r = sel->Select(ppdu, idle);
+        NS_TEST_EXPECT_MSG_EQ(r.channel, S::Range(2, 1), "PA-NPCA uses ch2");
+        NS_TEST_EXPECT_MSG_EQ(r.occupied, S::Range(0, 2) | S::Range(3, 1), "O = N \\ P");
+        NS_TEST_EXPECT_MSG_EQ_TOL(r.eta, 0.80, 1e-12, "two active neighbours");
+        // punctured but busy (CCA) -> not usable
+        NS_TEST_EXPECT_MSG_EQ(sel->Select(ppdu, 0).IsUsable(), false, "CCA busy");
+
+        // reliability gating: invalid pattern / signalling error -> P = empty
+        NpcaCausalPpdu bad = ppdu;
+        bad.punctured = S::Range(1, 2);
+        NS_TEST_EXPECT_MSG_EQ(sel->Select(bad, S::Range(1, 2)).IsUsable(), false, "invalid P");
+        bad = ppdu;
+        bad.signalingOk = false;
+        NS_TEST_EXPECT_MSG_EQ(sel->Select(bad, idle).IsUsable(), false, "signalling error");
+
+        // OFDMA segment verification (320 MHz BSS)
+        auto wide = CreateObject<NpcaChannelSelector>();
+        wide->SetAttribute("BssUnits", UintegerValue(16));
+        wide->SetAttribute("NpcaPrimary", IntegerValue(8));
+        NpcaCausalPpdu mu;
+        mu.nominal = S::Range(0, 16);
+        mu.punctured = S::Range(8, 4);
+        mu.ofdma = true;
+        mu.verifiedSegments = 0b0001; // only the primary 80 MHz segment verified
+        NS_TEST_EXPECT_MSG_EQ(wide->Select(mu, S::Range(8, 4)).IsUsable(), false, "unverified");
+        mu.verifiedSegments = 0b0101;
+        NS_TEST_EXPECT_MSG_EQ(wide->Select(mu, S::Range(8, 4)).channel, S::Range(8, 4), "verified");
+
+        // 160 MHz OBSS with 40 MHz hole merges into an 80+40 320 MHz pattern
+        NpcaCausalPpdu p160;
+        p160.nominal = S::Range(0, 8);
+        p160.punctured = S::Range(6, 2);
+        UnitSet idle160 = S::Range(6, 10);
+        wide->SetScheme(NpcaScheme::STANDARD);
+        NS_TEST_EXPECT_MSG_EQ(wide->Select(p160, idle160).units, 8, "standard");
+        wide->SetScheme(NpcaScheme::PUNCTURE_AWARE);
+        NS_TEST_EXPECT_MSG_EQ(wide->Select(p160, idle160).units, 10, "PA");
+
+        // PA-NPCA never narrower than standard NPCA, for every pattern and idle outcome
+        for (uint8_t w : {4, 8, 16})
+        {
+            for (const auto& phi : S::GetPuncturingPatterns(w, 0, 0))
+            {
+                for (uint32_t m = 0; m < (1U << phi.blocks.size()); ++m)
+                {
+                    NpcaCausalPpdu x;
+                    x.nominal = S::Range(0, w);
+                    x.punctured = phi.punctured;
+                    UnitSet busy = 0;
+                    for (size_t i = 0; i < phi.blocks.size(); ++i)
+                    {
+                        if (!((m >> i) & 1U))
+                        {
+                            busy |= phi.blocks[i];
+                        }
+                    }
+                    UnitSet cca = S::Range(0, 16) & ~(x.nominal & ~x.punctured) & ~busy;
+                    for (int unp = 1; unp < 16; ++unp)
+                    {
+                        wide->SetScheme(NpcaScheme::STANDARD);
+                        auto s = wide->SelectWithPrimary(x, cca, unp).units;
+                        wide->SetScheme(NpcaScheme::PUNCTURE_AWARE);
+                        auto pa = wide->SelectWithPrimary(x, cca, unp).units;
+                        NS_TEST_ASSERT_MSG_GT_OR_EQ(pa, s, "monotonicity");
+                    }
+                }
+            }
+        }
+    }
+};
+
+/**
+ * @ingroup npca-tests
+ * Analytical model.
+ */
+class NpcaModelTestCase : public TestCase
+{
+  public:
+    NpcaModelTestCase()
+        : TestCase("Analytical model, Eq. (4) and Eq. (5)")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        // Section V-A: model predicts 17.1 % and 34.3 % for q = 1
+        NS_TEST_EXPECT_MSG_EQ_TOL(NpcaAnalyticalModel::BaseGain(0.5, 0.4, 1.0), 0.1714, 1e-3, "");
+        NS_TEST_EXPECT_MSG_EQ_TOL(NpcaAnalyticalModel::BaseGain(0.5, 0.8, 1.0), 0.3429, 1e-3, "");
+
+        // Eq. (4) with the targeted single-channel model reduces to Eq. (5)
+        NpcaAnalyticalModel::Params p;
+        p.bssUnits = 4;
+        p.npcaPrimary = 2;
+        p.rho = 0.5;
+        p.widthDist = {{1, 0.15}, {2, 0.25}, {4, 0.6}};
+        p.targetedUnit = 2;
+        p.weighted = false;
+        for (double pp : {0.2, 0.4, 0.8})
+        {
+            for (double q : {0.5, 1.0})
+            {
+                p.pi = pp;
+                p.q = q;
+                NS_TEST_EXPECT_MSG_EQ_TOL(
+                    NpcaAnalyticalModel::GainOverStandard(p, NpcaAnalyticalModel::PUNCTURE_AWARE),
+                    NpcaAnalyticalModel::BaseGain(0.5, pp, q),
+                    1e-12,
+                    "Eq. (4) vs Eq. (5)");
+            }
+        }
+
+        // 320 MHz BSS, full-band OBSS: standard NPCA has no eligible channel
+        NpcaAnalyticalModel::Params w;
+        w.rho = 0.4;
+        double stdv = NpcaAnalyticalModel::ExpectedUnits(w, NpcaAnalyticalModel::STANDARD);
+        NS_TEST_EXPECT_MSG_EQ_TOL(stdv, 0.6 * 16, 1e-9, "standard = legacy");
+        double pa = NpcaAnalyticalModel::ExpectedUnits(w, NpcaAnalyticalModel::PUNCTURE_AWARE);
+        double flex = NpcaAnalyticalModel::ExpectedUnits(w, NpcaAnalyticalModel::FLEXIBLE);
+        double unc = NpcaAnalyticalModel::ExpectedUnits(w, NpcaAnalyticalModel::UNCONSTRAINED);
+        NS_TEST_EXPECT_MSG_GT(pa, stdv, "");
+        NS_TEST_EXPECT_MSG_GT_OR_EQ(flex, pa, "");
+        NS_TEST_EXPECT_MSG_GT_OR_EQ(unc, flex, "");
+    }
+};
+
+/**
+ * @ingroup npca-tests
+ * Short end-to-end DCF runs.
+ */
+class NpcaSimulationTestCase : public TestCase
+{
+  public:
+    NpcaSimulationTestCase()
+        : TestCase("DCF simulation ordering legacy < standard < puncture-aware")
+    {
+    }
+
+  private:
+    double RunOne(NpcaScheme scheme)
+    {
+        RngSeedManager::SetSeed(1);
+        RngSeedManager::SetRun(1);
+        auto sim = CreateObject<NpcaDcfSimulation>();
+        sim->SetAttribute("Duration", TimeValue(Seconds(2)));
+        sim->GetSelector()->SetScheme(scheme);
+        sim->GetObssSource()->SetAttribute("TargetedUnit", IntegerValue(2));
+        sim->GetObssSource()->SetAttribute("PuncturingProbability", DoubleValue(0.8));
+        sim->GetObssSource()->SetAttribute("IdleProbability", DoubleValue(1.0));
+        sim->AssignStreams(0);
+        double t = sim->Run().throughput;
+        sim->Dispose();
+        Simulator::Destroy();
+        return t;
+    }
+
+    void DoRun() override
+    {
+        double legacy = RunOne(NpcaScheme::LEGACY);
+        double standard = RunOne(NpcaScheme::STANDARD);
+        double pa = RunOne(NpcaScheme::PUNCTURE_AWARE);
+        NS_TEST_EXPECT_MSG_GT(legacy, 0.1, "");
+        NS_TEST_EXPECT_MSG_GT(standard, legacy * 1.15, "standard NPCA helps");
+        NS_TEST_EXPECT_MSG_GT(pa, standard * 1.15, "PA-NPCA helps (ppunc=0.8, q=1)");
+        NS_TEST_EXPECT_MSG_LT(pa, 1.0, "");
+    }
+};
+
+/**
+ * @ingroup npca-tests
+ * Test suite.
+ */
+class NpcaTestSuite : public TestSuite
+{
+  public:
+    NpcaTestSuite()
+        : TestSuite("npca", Type::UNIT)
+    {
+        AddTestCase(new NpcaChannelSetsTestCase, TestCase::Duration::QUICK);
+        AddTestCase(new NpcaSelectorTestCase, TestCase::Duration::QUICK);
+        AddTestCase(new NpcaModelTestCase, TestCase::Duration::QUICK);
+        AddTestCase(new NpcaSimulationTestCase, TestCase::Duration::QUICK);
+    }
+};
+
+static NpcaTestSuite g_npcaTestSuite; //!< static instance
