+void
+EhtFrameExchangeManager::SendNpcaIcr(const WifiMacHeader& icfHdr,
+                                     const WifiTxVector& icfTxVector,
+                                     uint16_t aid)
+{
+    NS_LOG_FUNCTION(this << icfHdr << icfTxVector << aid);
+
+    CtrlBAckResponseHeader ba;
+    ba.SetType({BlockAckType::MULTI_STA, {0}});
+    ba.SetAid11(aid, 0);
+    ba.SetAckType(true, 0);
+    ba.SetTidInfo(ICR_CONTEXT_TID, 0);
+
+    WifiMacHeader hdr;
+    hdr.SetType(WIFI_MAC_CTL_BACKRESP);
+    hdr.SetAddr1(icfHdr.GetAddr2());
+    hdr.SetAddr2(m_self);
+    hdr.SetDsNotFrom();
+    hdr.SetDsNotTo();
+
+    // non-HT (duplicate) PPDU with the primary rate, i.e., the rate of the BSRP NTB Trigger
+    // frame, and the bandwidth of the BSRP NTB Trigger frame
+    WifiTxVector icrTxVector =
+        GetWifiRemoteStationManager()->GetCtsTxVector(icfHdr.GetAddr2(), icfTxVector.GetMode());
+    icrTxVector.SetMode(icfTxVector.GetMode());
+    icrTxVector.SetChannelWidth(icfTxVector.GetChannelWidth());
+
+    const auto icrDuration =
+        WifiPhy::CalculateTxDuration(GetNpcaIcrSize(), icrTxVector, m_phy->GetPhyBand());
+    // the Duration/ID field is set as for a CTS frame sent in response to an RTS frame
+    auto duration = icfHdr.GetDuration() - m_phy->GetSifs() - icrDuration;
+    if (duration.IsStrictlyNegative())
+    {
+        duration = Seconds(0);
+    }
+    hdr.SetDuration(duration);
+
+    auto packet = Create<Packet>();
+    packet->AddHeader(ba);
+    ForwardMpduDown(Create<WifiMpdu>(packet, hdr), icrTxVector);
+}
