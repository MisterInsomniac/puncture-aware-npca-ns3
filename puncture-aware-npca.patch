+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include "npca-channel-selector.h"
+
+#include "ns3/boolean.h"
+#include "ns3/double.h"
+#include "ns3/enum.h"
+#include "ns3/integer.h"
+#include "ns3/log.h"
+#include "ns3/uinteger.h"
+
+namespace ns3
+{
+
+NS_LOG_COMPONENT_DEFINE("NpcaChannelSelector");
+NS_OBJECT_ENSURE_REGISTERED(NpcaChannelSelector);
+
+TypeId
+NpcaChannelSelector::GetTypeId()
+{
+    static TypeId tid =
+        TypeId("ns3::NpcaChannelSelector")
+            .SetParent<Object>()
+            .SetGroupName("Npca")
+            .AddConstructor<NpcaChannelSelector>()
+            .AddAttribute("BssUnits",
+                          "Width of the BSS operating channel in 20 MHz units (1,2,4,8,16).",
+                          UintegerValue(4),
+                          MakeUintegerAccessor(&NpcaChannelSelector::m_bssUnits),
+                          MakeUintegerChecker<uint8_t>(1, 16))
+            .AddAttribute("PrimaryUnit",
+                          "Unit index (frequency order) of the BSS primary 20 MHz channel.",
+                          UintegerValue(0),
+                          MakeUintegerAccessor(&NpcaChannelSelector::m_primaryUnit),
+                          MakeUintegerChecker<uint8_t>(0, 15))
+            .AddAttribute("NpcaPrimary",
+                          "Unit index of the NPCA primary channel; -1 = flexible (any unit).",
+                          IntegerValue(2),
+                          MakeIntegerAccessor(&NpcaChannelSelector::m_npcaPrimary),
+                          MakeIntegerChecker<int>(-1, 15))
+            .AddAttribute("Scheme",
+                          "NPCA scheme.",
+                          EnumValue(NpcaScheme::PUNCTURE_AWARE),
+                          MakeEnumAccessor<NpcaScheme>(&NpcaChannelSelector::m_scheme),
+                          MakeEnumChecker(NpcaScheme::LEGACY,
+                                          "Legacy",
+                                          NpcaScheme::STANDARD,
+                                          "Standard",
+                                          NpcaScheme::PUNCTURE_AWARE,
+                                          "PunctureAware"))
+            .AddAttribute("Unconstrained",
+                          "Use |A| instead of the 802.11be-compliant T(A,unp) (upper bound).",
+                          BooleanValue(false),
+                          MakeBooleanAccessor(&NpcaChannelSelector::m_unconstrained),
+                          MakeBooleanChecker())
+            .AddAttribute("LeakageAware",
+                          "Select the compliant set maximizing |S|*eta(S) (Section IV-A).",
+                          BooleanValue(false),
+                          MakeBooleanAccessor(&NpcaChannelSelector::m_leakageAware),
+                          MakeBooleanChecker())
+            .AddAttribute("Eta1",
+                          "Rate fraction of a unit with one active OBSS neighbour.",
+                          DoubleValue(1.0),
+                          MakeDoubleAccessor(&NpcaChannelSelector::m_eta1),
+                          MakeDoubleChecker<double>(0.0, 1.0))
+            .AddAttribute("Eta2",
+                          "Rate fraction of a unit with two active OBSS neighbours.",
+                          DoubleValue(1.0),
+                          MakeDoubleAccessor(&NpcaChannelSelector::m_eta2),
+                          MakeDoubleChecker<double>(0.0, 1.0))
+            .AddAttribute("DisabledSubchannelBitmap",
+                          "NPCA Disabled Subchannel Bitmap (bit i = unit i not usable).",
+                          UintegerValue(0),
+                          MakeUintegerAccessor(&NpcaChannelSelector::m_disabledMask),
+                          MakeUintegerChecker<uint32_t>());
+    return tid;
+}
+
+NpcaChannelSelector::NpcaChannelSelector()
+    : m_bssUnits(4),
+      m_primaryUnit(0),
+      m_npcaPrimary(2),
+      m_scheme(NpcaScheme::PUNCTURE_AWARE),
+      m_unconstrained(false),
+      m_leakageAware(false),
+      m_eta1(1.0),
+      m_eta2(1.0),
+      m_disabledMask(0)
+{
+}
+
+NpcaChannelSelector::~NpcaChannelSelector() = default;
+
+bool
+NpcaChannelSelector::PuncturingReliable(const NpcaCausalPpdu& ppdu)
+{
+    if (!ppdu.signalingOk)
+    {
+        return false;
+    }
+    if (ppdu.punctured == 0)
+    {
+        return true;
+    }
+    if ((ppdu.punctured & ~ppdu.nominal) != 0)
+    {
+        return false; // P must lie inside N
+    }
+    uint8_t width = NpcaChannelSets::Count(ppdu.nominal);
+    if (width < 4 || ppdu.nominal == 0)
+    {
+        return false;
+    }
+    auto base = static_cast<uint8_t>(__builtin_ctz(ppdu.nominal));
+    if (ppdu.nominal != NpcaChannelSets::Range(base, width))
+    {
+        return false;
+    }
+    for (const auto& p : NpcaChannelSets::GetPuncturingPatterns(width, base, -1))
+    {
+        if (p.punctured == ppdu.punctured)
+        {
+            return true;
+        }
+    }
+    return false;
+}
+
+UnitSet
+NpcaChannelSelector::VerifiedPuncturedSet(const NpcaCausalPpdu& ppdu)
+{
+    if (!ppdu.ofdma)
+    {
+        return ppdu.punctured;
+    }
+    UnitSet ver = 0;
+    for (uint8_t seg = 0; seg < 8; ++seg)
+    {
+        if ((ppdu.verifiedSegments >> seg) & 1U)
+        {
+            ver |= ppdu.punctured & NpcaChannelSets::Range(4 * seg, 4);
+        }
+    }
+    return ver;
+}
+
+double
+NpcaChannelSelector::Eta(UnitSet s, UnitSet occupied) const
+{
+    uint8_t worst = 0;
+    for (uint8_t u = 0; u < m_bssUnits; ++u)
+    {
+        if (!NpcaChannelSets::Contains(s, u))
+        {
+            continue;
+        }
+        uint8_t n = 0;
+        if (u > 0 && NpcaChannelSets::Contains(occupied, u - 1))
+        {
+            ++n;
+        }
+        if (u + 1 < m_bssUnits && NpcaChannelSets::Contains(occupied, u + 1))
+        {
+            ++n;
+        }
+        worst = std::max(worst, n);
+    }
+    return worst == 0 ? 1.0 : (worst == 1 ? m_eta1 : m_eta2);
+}
+
+NpcaSelection
+NpcaChannelSelector::Select(const NpcaCausalPpdu& ppdu, UnitSet ccaIdle) const
+{
+    return SelectWithPrimary(ppdu, ccaIdle, m_npcaPrimary);
+}
+
+NpcaSelection
+NpcaChannelSelector::SelectWithPrimary(const NpcaCausalPpdu& ppdu,
+                                       UnitSet ccaIdle,
+                                       int npcaPrimary) const
+{
+    NpcaSelection sel;
+    const UnitSet bss = NpcaChannelSets::Range(0, m_bssUnits);
+    if (m_scheme == NpcaScheme::LEGACY)
+    {
+        sel.occupied = ppdu.nominal & bss;
+        return sel;
+    }
+
+    // Lines 2-6: reliability gating and OFDMA segment verification
+    UnitSet p = 0;
+    if (m_scheme == NpcaScheme::PUNCTURE_AWARE && PuncturingReliable(ppdu))
+    {
+        p = VerifiedPuncturedSet(ppdu);
+    }
+    const UnitSet nominal = ppdu.nominal & bss;
+    sel.occupied = nominal & ~p;
+
+    // Line 7, Eq. (2): A = (U \ N) u (P n I), minus the NPCA Disabled Subchannel Bitmap.
+    // Out-of-band units must pass CCA as well.
+    sel.available = (((bss & ~nominal) | p) & ccaIdle & bss) & ~m_disabledMask;
+    sel.available &= ~NpcaChannelSets::Range(m_primaryUnit, 1); // causal PPDU holds the primary
+
+    // Line 8, Eq. (3)
+    auto eta = [this, &sel](UnitSet s) { return Eta(s, sel.occupied); };
+    if (m_unconstrained)
+    {
+        sel.channel = sel.available;
+    }
+    else if (m_leakageAware)
+    {
+        sel.channel = NpcaChannelSets::BestCompliantSet(sel.available, npcaPrimary, m_bssUnits, eta);
+    }
+    else
+    {
+        sel.channel = NpcaChannelSets::LargestCompliantSet(sel.available, npcaPrimary, m_bssUnits);
+    }
+    sel.units = NpcaChannelSets::Count(sel.channel);
+    sel.eta = sel.units > 0 ? eta(sel.channel) : 1.0;
+    NS_LOG_DEBUG("N=" << NpcaChannelSets::ToString(nominal) << " P=" << NpcaChannelSets::ToString(p)
+                      << " A=" << NpcaChannelSets::ToString(sel.available)
+                      << " C=" << NpcaChannelSets::ToString(sel.channel));
+    return sel;
+}
+
+void
+NpcaChannelSelector::SetScheme(NpcaScheme scheme)
+{
+    m_scheme = scheme;
+}
+
+NpcaScheme
+NpcaChannelSelector::GetScheme() const
+{
+    return m_scheme;
+}
+
+void
+NpcaChannelSelector::SetNpcaPrimary(int unp)
+{
+    m_npcaPrimary = unp;
+}
+
+int
+NpcaChannelSelector::GetNpcaPrimary() const
+{
+    return m_npcaPrimary;
+}
+
+uint8_t
+NpcaChannelSelector::GetBssUnits() const
+{
+    return m_bssUnits;
+}
+
+} // namespace ns3
diff --git a/src/npca/model/npca-channel-selector.h b/src/npca/model/npca-channel-selector.h
new file mode 100644
index 0000000..b22189a
--- /dev/null
+++ b/src/npca/model/npca-channel-selector.h
@@ -0,0 +1,157 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#ifndef NPCA_CHANNEL_SELECTOR_H
+#define NPCA_CHANNEL_SELECTOR_H
+
+#include "npca-channel-sets.h"
+
+#include "ns3/object.h"
+
+namespace ns3
+{
+
+/**
+ * @ingroup npca
+ * NPCA flavours compared in the paper.
+ */
+enum class NpcaScheme : uint8_t
+{
+    LEGACY = 0,     //!< no NPCA: wait for the primary channel
+    STANDARD,       //!< P802.11bn D2.0 NPCA, eligibility from CH_BANDWIDTH only (P = empty)
+    PUNCTURE_AWARE, //!< PA-NPCA: occupied set O = N \ P
+};
+
+/**
+ * @ingroup npca
+ * What the station learns from the RXVECTOR of the causal inter-BSS PPDU,
+ * expressed in the 20 MHz unit indexing of the observing BSS: units are numbered in
+ * increasing frequency order and the BSS primary 20 MHz is unit PrimaryUnit (0 in the paper).
+ */
+struct NpcaCausalPpdu
+{
+    UnitSet nominal{0};             //!< N, units spanned by CH_BANDWIDTH
+    UnitSet punctured{0};           //!< P, units signalled in INACTIVE_SUBCHANNELS
+    bool signalingOk{true};         //!< U-SIG/EHT-SIG decoded without error, duplicates consistent
+    bool ofdma{false};              //!< the causal PPDU is an OFDMA (MU) PPDU
+    uint32_t verifiedSegments{~0U}; //!< for OFDMA: bit k set <=> local bitmap of 80 MHz segment k
+                                    //!< recovered, valid and bound to this PPDU
+};
+
+/**
+ * @ingroup npca
+ * Result of the NPCA channel selection.
+ */
+struct NpcaSelection
+{
+    UnitSet occupied{0};  //!< exclusion set N \ P_ver (equals O once all segments verified)
+    UnitSet available{0}; //!< A, Eq. (2)
+    UnitSet channel{0};   //!< C, Eq. (3); 0 => wait for the primary channel
+    uint8_t units{0};     //!< number of 20 MHz units carried by the NPCA PPDU
+    double eta{1.0};      //!< rate fraction under the adjacent-channel penalty
+
+    /// @return true if NPCA can be used
+    bool IsUsable() const
+    {
+        return units > 0;
+    }
+};
+
+/**
+ * @ingroup npca
+ * Implements Algorithm 1 of the paper (Puncture-Aware NPCA channel selection) and, for
+ * comparison, standard D2.0 NPCA. The ACCESS CONDITIONS (inter-BSS classification, intra-BSS
+ * NAV, minimum duration and NPCA timer) are enforced by the MAC/DCF model that calls this
+ * class.
+ */
+class NpcaChannelSelector : public Object
+{
+  public:
+    /**
+     * @brief Get the type ID.
+     * @return the object TypeId
+     */
+    static TypeId GetTypeId();
+
+    NpcaChannelSelector();
+    ~NpcaChannelSelector() override;
+
+    /**
+     * Run Algorithm 1.
+     *
+     * @param ppdu what the RXVECTOR of the causal PPDU says
+     * @param ccaIdle I, the units that pass per-unit CCA
+     * @return the selection
+     */
+    NpcaSelection Select(const NpcaCausalPpdu& ppdu, UnitSet ccaIdle) const;
+
+    /**
+     * As Select() but forcing a given NPCA primary channel (used by the
+     * puncture-informed primary selection to evaluate candidates).
+     *
+     * @param ppdu the causal PPDU
+     * @param ccaIdle I
+     * @param npcaPrimary candidate unp (negative: flexible)
+     * @return the selection
+     */
+    NpcaSelection SelectWithPrimary(const NpcaCausalPpdu& ppdu,
+                                    UnitSet ccaIdle,
+                                    int npcaPrimary) const;
+
+    /**
+     * PuncturingReliable() of Algorithm 1: signalling decoded and P is an allowed
+     * 802.11be pattern of the signalled bandwidth.
+     *
+     * @param ppdu the causal PPDU
+     * @return true if P may be used
+     */
+    static bool PuncturingReliable(const NpcaCausalPpdu& ppdu);
+
+    /**
+     * VerifiedPuncturedSet() of Algorithm 1 / Section IV-B: for OFDMA PPDUs keep
+     * only punctured units of verified 80 MHz segments.
+     *
+     * @param ppdu the causal PPDU
+     * @return P_ver
+     */
+    static UnitSet VerifiedPuncturedSet(const NpcaCausalPpdu& ppdu);
+
+    /**
+     * Rate fraction eta(S) of a candidate NPCA set: set by its worst unit, i.e.
+     * the unit with the most first-adjacent units in @p occupied.
+     *
+     * @param s candidate set
+     * @param occupied active OBSS units
+     * @return eta
+     */
+    double Eta(UnitSet s, UnitSet occupied) const;
+
+    /// @param scheme the scheme
+    void SetScheme(NpcaScheme scheme);
+    /// @return the scheme
+    NpcaScheme GetScheme() const;
+    /// @param unp NPCA primary unit (negative: flexible)
+    void SetNpcaPrimary(int unp);
+    /// @return the NPCA primary unit
+    int GetNpcaPrimary() const;
+    /// @return U
+    uint8_t GetBssUnits() const;
+
+  private:
+    uint8_t m_bssUnits;      //!< U
+    uint8_t m_primaryUnit;   //!< index of the BSS primary 20 MHz (frequency order)
+    int m_npcaPrimary;       //!< unp (negative = flexible)
+    NpcaScheme m_scheme;     //!< scheme
+    bool m_unconstrained;    //!< use |A| instead of T(A, unp) (analysis bound)
+    bool m_leakageAware;     //!< maximize |S| eta(S) instead of |S|
+    double m_eta1;           //!< eta with one active neighbour
+    double m_eta2;           //!< eta with two active neighbours
+    uint32_t m_disabledMask; //!< NPCA Disabled Subchannel Bitmap
+};
+
+} // namespace ns3
+
+#endif /* NPCA_CHANNEL_SELECTOR_H */
diff --git a/src/npca/model/npca-channel-sets.cc b/src/npca/model/npca-channel-sets.cc
new file mode 100644
index 0000000..bbd646c
--- /dev/null
+++ b/src/npca/model/npca-channel-sets.cc
@@ -0,0 +1,209 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include "npca-channel-sets.h"
+
+#include "ns3/abort.h"
+
+#include <algorithm>
+#include <map>
+#include <sstream>
+
+namespace ns3
+{
+
+UnitSet
+NpcaChannelSets::Range(uint8_t first, uint8_t count)
+{
+    if (count == 0)
+    {
+        return 0;
+    }
+    UnitSet ones = (count >= 32) ? 0xffffffffU : ((1U << count) - 1U);
+    return ones << first;
+}
+
+uint8_t
+NpcaChannelSets::Count(UnitSet s)
+{
+    return static_cast<uint8_t>(__builtin_popcount(s));
+}
+
+bool
+NpcaChannelSets::Contains(UnitSet s, uint8_t u)
+{
+    return (s >> u) & 1U;
+}
+
+std::string
+NpcaChannelSets::ToString(UnitSet s)
+{
+    std::ostringstream oss;
+    oss << "{";
+    bool first = true;
+    for (uint8_t u = 0; u < 32; ++u)
+    {
+        if (Contains(s, u))
+        {
+            oss << (first ? "" : ",") << +u;
+            first = false;
+        }
+    }
+    oss << "}";
+    return oss.str();
+}
+
+std::vector<PuncturingPattern>
+NpcaChannelSets::GetPuncturingPatterns(uint8_t widthUnits, uint8_t base, int protectedUnit)
+{
+    std::vector<PuncturingPattern> raw;
+    auto single = [&raw](UnitSet b) { raw.push_back({b, {b}}); };
+
+    switch (widthUnits)
+    {
+    case 1:
+    case 2:
+        break;
+    case 4: // 80 MHz: one 20 MHz subchannel
+        for (uint8_t i = 0; i < 4; ++i)
+        {
+            single(Range(base + i, 1));
+        }
+        break;
+    case 8: // 160 MHz: one 20 MHz or one aligned 40 MHz subchannel
+        for (uint8_t i = 0; i < 8; ++i)
+        {
+            single(Range(base + i, 1));
+        }
+        for (uint8_t i = 0; i < 8; i += 2)
+        {
+            single(Range(base + i, 2));
+        }
+        break;
+    case 16: // 320 MHz
+        for (uint8_t i = 0; i < 16; i += 2)
+        {
+            single(Range(base + i, 2)); // one aligned 40
+        }
+        for (uint8_t i = 0; i < 16; i += 4)
+        {
+            single(Range(base + i, 4)); // one aligned 80
+        }
+        for (uint8_t edge : {uint8_t{0}, uint8_t{12}})
+        {
+            UnitSet edge80 = Range(base + edge, 4);
+            for (uint8_t i = 0; i < 16; i += 2)
+            {
+                UnitSet forty = Range(base + i, 2);
+                if ((forty & edge80) != 0)
+                {
+                    continue;
+                }
+                // a 40 adjacent to the edge 80 merges into a contiguous hole but is still
+                // signalled (and modelled) as two independent blocks
+                raw.push_back({edge80 | forty, {edge80, forty}});
+            }
+        }
+        break;
+    default:
+        NS_ABORT_MSG("Unsupported PPDU width (units): " << +widthUnits);
+    }
+
+    std::vector<PuncturingPattern> out;
+    for (const auto& p : raw)
+    {
+        if (protectedUnit >= 0 && Contains(p.punctured, static_cast<uint8_t>(protectedUnit)))
+        {
+            continue;
+        }
+        out.push_back(p);
+    }
+    return out;
+}
+
+const std::vector<UnitSet>&
+NpcaChannelSets::GetCompliantSets(uint8_t bssUnits)
+{
+    static std::map<uint8_t, std::vector<UnitSet>> cache;
+    auto it = cache.find(bssUnits);
+    if (it != cache.end())
+    {
+        return it->second;
+    }
+    NS_ABORT_MSG_IF(bssUnits != 1 && bssUnits != 2 && bssUnits != 4 && bssUnits != 8 &&
+                        bssUnits != 16,
+                    "BSS width must be 1, 2, 4, 8 or 16 units");
+    std::vector<UnitSet> sets;
+    for (uint8_t w = 1; w <= bssUnits; w *= 2)
+    {
+        for (uint8_t b = 0; b + w <= bssUnits; b += w)
+        {
+            UnitSet full = Range(b, w);
+            sets.push_back(full);
+            if (w >= 4)
+            {
+                for (const auto& p : GetPuncturingPatterns(w, b, -1))
+                {
+                    sets.push_back(full & ~p.punctured);
+                }
+            }
+        }
+    }
+    std::sort(sets.begin(), sets.end());
+    sets.erase(std::unique(sets.begin(), sets.end()), sets.end());
+    std::stable_sort(sets.begin(), sets.end(), [](UnitSet a, UnitSet b) {
+        return Count(a) > Count(b);
+    });
+    return cache.emplace(bssUnits, std::move(sets)).first->second;
+}
+
+UnitSet
+NpcaChannelSets::LargestCompliantSet(UnitSet available, int npcaPrimary, uint8_t bssUnits)
+{
+    for (UnitSet s : GetCompliantSets(bssUnits)) // sorted by decreasing size
+    {
+        if ((s & ~available) != 0)
+        {
+            continue;
+        }
+        if (npcaPrimary >= 0 && !Contains(s, static_cast<uint8_t>(npcaPrimary)))
+        {
+            continue;
+        }
+        return s;
+    }
+    return 0;
+}
+
+UnitSet
+NpcaChannelSets::BestCompliantSet(UnitSet available,
+                                  int npcaPrimary,
+                                  uint8_t bssUnits,
+                                  const std::function<double(UnitSet)>& eta)
+{
+    UnitSet best = 0;
+    double bestValue = 0.0;
+    for (UnitSet s : GetCompliantSets(bssUnits))
+    {
+        if ((s & ~available) != 0)
+        {
+            continue;
+        }
+        if (npcaPrimary >= 0 && !Contains(s, static_cast<uint8_t>(npcaPrimary)))
+        {
+            continue;
+        }
+        double v = Count(s) * eta(s);
+        if (v > bestValue + 1e-12)
+        {
+            best = s;
+            bestValue = v;
+        }
+    }
+    return best;
+}
+
+} // namespace ns3
diff --git a/src/npca/model/npca-channel-sets.h b/src/npca/model/npca-channel-sets.h
new file mode 100644
index 0000000..ac81dac
--- /dev/null
+++ b/src/npca/model/npca-channel-sets.h
@@ -0,0 +1,119 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Puncture-Aware Non-Primary Channel Access (PA-NPCA) for ns-3.
+ *
+ * Channel-set algebra used by NPCA: a BSS channel of U 20 MHz "units"
+ * (U = 1, 2, 4, 8 or 16), the IEEE 802.11be non-OFDMA preamble puncturing
+ * patterns and the finite family T of 802.11be-compliant unit sets that an
+ * NPCA PPDU may occupy (Section III of the paper).
+ */
+
+#ifndef NPCA_CHANNEL_SETS_H
+#define NPCA_CHANNEL_SETS_H
+
+#include <cstdint>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace ns3
+{
+
+/**
+ * @ingroup npca
+ * A set of 20 MHz units, bit i set <=> unit i is in the set (unit 0 = BSS primary 20 MHz).
+ */
+using UnitSet = uint32_t;
+
+/**
+ * @ingroup npca
+ * A preamble puncturing pattern: the punctured units, split into the contiguous
+ * "blocks" that the paper models as independently idle (prob. q) or busy.
+ * E.g. the 320 MHz "highest 80 + one 40" pattern has two blocks.
+ */
+struct PuncturingPattern
+{
+    UnitSet punctured{0};          //!< union of all blocks
+    std::vector<UnitSet> blocks;   //!< independent blocks
+};
+
+/**
+ * @ingroup npca
+ * Static helpers for unit sets, 802.11be puncturing patterns and compliant sets.
+ */
+class NpcaChannelSets
+{
+  public:
+    /// @return the set {first, ..., first+count-1}
+    static UnitSet Range(uint8_t first, uint8_t count);
+    /// @return the number of units in s
+    static uint8_t Count(UnitSet s);
+    /// @return true if unit u is in s
+    static bool Contains(UnitSet s, uint8_t u);
+    /// @return a human-readable representation, e.g. "{0,1,3}"
+    static std::string ToString(UnitSet s);
+
+    /**
+     * Allowed 802.11be non-OFDMA puncturing patterns of a PPDU of width
+     * @p widthUnits (4, 8 or 16 units) whose lowest unit is @p base.
+     * Widths below 80 MHz have no patterns.
+     *
+     *  - 80 MHz : one 20 MHz subchannel
+     *  - 160 MHz: one 20 MHz or one aligned 40 MHz subchannel
+     *  - 320 MHz: one aligned 40 or 80 MHz subchannel, or the lowest or highest
+     *             80 MHz plus one further aligned 40 MHz subchannel
+     *
+     * @param widthUnits the PPDU width in 20 MHz units
+     * @param base the lowest unit of the PPDU
+     * @param protectedUnit if >= 0, patterns puncturing this unit are excluded
+     *        (the primary 20 MHz of the transmitter can never be punctured)
+     * @return the list of patterns
+     */
+    static std::vector<PuncturingPattern> GetPuncturingPatterns(uint8_t widthUnits,
+                                                                uint8_t base = 0,
+                                                                int protectedUnit = 0);
+
+    /**
+     * The finite family T of 802.11be-compliant unit sets inside a BSS channel of
+     * @p bssUnits units: every aligned 20/40/80/160/320 MHz channel, unpunctured or
+     * with one allowed puncturing pattern (95 sets for U = 16, 11 for U = 4).
+     * The result is cached and sorted by decreasing size.
+     *
+     * @param bssUnits the BSS channel width in units
+     * @return the compliant sets
+     */
+    static const std::vector<UnitSet>& GetCompliantSets(uint8_t bssUnits);
+
+    /**
+     * Eq. (3): the largest compliant set S with unp in S and S subset of A.
+     *
+     * @param available the available set A
+     * @param npcaPrimary unp; if negative, any unit may be the NPCA primary
+     *        ("flexible" variant)
+     * @param bssUnits U
+     * @return the chosen set C (0 if none)
+     */
+    static UnitSet LargestCompliantSet(UnitSet available, int npcaPrimary, uint8_t bssUnits);
+
+    /**
+     * As LargestCompliantSet, but maximizing |S| * eta(S) (leakage-aware selection
+     * of Section IV-A). Ties are broken in favour of the wider set.
+     *
+     * @param available the available set A
+     * @param npcaPrimary unp (negative: flexible)
+     * @param bssUnits U
+     * @param eta rate fraction supported by a candidate set
+     * @return the chosen set C (0 if none)
+     */
+    static UnitSet BestCompliantSet(UnitSet available,
+                                    int npcaPrimary,
+                                    uint8_t bssUnits,
+                                    const std::function<double(UnitSet)>& eta);
+};
+
+} // namespace ns3
+
+#endif /* NPCA_CHANNEL_SETS_H */
diff --git a/src/npca/model/npca-dcf-simulation.cc b/src/npca/model/npca-dcf-simulation.cc
