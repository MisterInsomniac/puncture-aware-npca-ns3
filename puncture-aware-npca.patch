index 0000000..9ff34d7
--- /dev/null
+++ b/src/npca/model/npca-analytical-model.h
@@ -0,0 +1,86 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#ifndef NPCA_ANALYTICAL_MODEL_H
+#define NPCA_ANALYTICAL_MODEL_H
+
+#include "npca-channel-sets.h"
+
+#include <utility>
+#include <vector>
+
+namespace ns3
+{
+
+/**
+ * @ingroup npca
+ * Exact expected usable NPCA bandwidth, Eq. (4) of the paper, and the single-channel
+ * reduction, Eq. (5). These ignore DCF collisions, switching delays and the NPCA timer
+ * and are therefore upper bounds for the simulation.
+ */
+class NpcaAnalyticalModel
+{
+  public:
+    /// Variants of the aggregation term T
+    enum Variant
+    {
+        STANDARD,       //!< P = empty
+        PUNCTURE_AWARE, //!< T(A_W u B, unp)
+        FLEXIBLE,       //!< any unit may serve as NPCA primary
+        UNCONSTRAINED,  //!< |A| instead of T (no pattern constraint)
+    };
+
+    /// Model inputs
+    struct Params
+    {
+        uint8_t bssUnits{16};                               //!< U
+        int npcaPrimary{8};                                 //!< unp
+        double rho{0.4};                                    //!< primary OBSS occupancy
+        std::vector<std::pair<uint8_t, double>> widthDist{{16, 1.0}}; //!< P(W)
+        double pi{0.3};                                     //!< puncturing prevalence
+        double q{0.8};                                      //!< P(punctured block idle)
+        int targetedUnit{-1}; //!< >= 0: 80 MHz PPDUs puncture only this unit (Sec. V-A)
+        bool weighted{true};  //!< false: count NPCA opportunities (1{T>0}) instead of units
+    };
+
+    /**
+     * Eq. (4).
+     * @param p the parameters
+     * @param v the variant
+     * @return E[|C|] (units, or availability probability if !weighted)
+     */
+    static double ExpectedUnits(const Params& p, Variant v);
+
+    /**
+     * Relative gain of a variant over standard NPCA, Eq. (4) ratio minus one.
+     * @param p parameters
+     * @param v variant
+     * @return gain (0.171 = 17.1 %)
+     */
+    static double GainOverStandard(const Params& p, Variant v);
+
+    /**
+     * Eq. (5): G_base = 0.6 rho ppunc q / ((1 - rho) + 0.4 rho).
+     * @param rho duty cycle
+     * @param ppunc probability ch2 is punctured in an 80 MHz OBSS PPDU
+     * @param q idle probability
+     * @return the gain
+     */
+    static double BaseGain(double rho, double ppunc, double q);
+
+    /**
+     * The aggregation term for a given A.
+     * @param a available set
+     * @param p parameters
+     * @param v variant
+     * @return T(A, unp) or |A| or the flexible T
+     */
+    static double Term(UnitSet a, const Params& p, Variant v);
+};
+
+} // namespace ns3
+
+#endif /* NPCA_ANALYTICAL_MODEL_H */
