+std::optional<MHz_u>
+NpcaManager::ComputeNpcaWidth(Ptr<const WifiPpdu> ppdu, std::string& reason) const
+{
+    auto phy = m_mac->GetWifiPhy(SINGLE_LINK_OP_ID);
+    const auto& op = phy->GetOperatingChannel();
+    if (op.GetNSegments() != 1)
+    {
+        reason = "non-contiguous operating channel";
+        return std::nullopt;
+    }
+    const auto bssWidth = op.GetTotalWidth();
+    const auto nUnits = static_cast<int>(bssWidth / MHz_u{20});
+    const auto lowEdge = op.GetFrequency() - bssWidth / 2;
+
+    const auto& txVector = ppdu->GetTxVector();
+    const auto ppduWidth = txVector.GetChannelWidth();
+    const auto ppduCenters = ppdu->GetTxCenterFreqs();
+    if (ppduCenters.size() != 1)
+    {
+        reason = "non-contiguous causal PPDU";
+        return std::nullopt;
+    }
+    // first 20 MHz unit spanned by the causal PPDU (CH_BANDWIDTH), in our unit indexing
+    const auto first = static_cast<int>(
+        std::lround((ppduCenters.front() - ppduWidth / 2 - lowEdge) / MHz_u{20}));
+    const auto ppduUnits = std::max(1, static_cast<int>(ppduWidth / MHz_u{20}));
+    uint32_t nominal = 0;
+    for (int u = std::max(0, first); u < std::min(nUnits, first + ppduUnits); ++u)
+    {
+        nominal |= (1U << u);
+    }
+
+    // P from INACTIVE_SUBCHANNELS, used only if valid (reliability gating)
+    uint32_t punctured = 0;
+    if (m_punctureAware)
+    {
+        const auto& inactive = txVector.GetInactiveSubchannels();
+        int count = 0;
+        int lowest = -1;
+        for (std::size_t i = 0; i < inactive.size(); ++i)
+        {
+            if (inactive[i])
+            {
+                lowest = (lowest < 0) ? static_cast<int>(i) : lowest;
+                ++count;
+                const auto u = first + static_cast<int>(i);
+                if (u >= 0 && u < nUnits)
+                {
+                    punctured |= (1U << u);
+                }
+            }
+        }
+        // allowed non-OFDMA patterns up to 160 MHz: one 20 MHz or one aligned 40 MHz
+        // subchannel; for 320 MHz also one aligned 80 MHz subchannel
+        const bool contiguous = count > 0 && (punctured >> (first + lowest)) == ((1U << count) - 1);
+        const bool valid = count == 0 || (contiguous && (count == 1 || ((count == 2 || count == 4) &&
+                                                                      lowest % count == 0)));
+        if (!valid || (punctured & ~nominal) != 0 || ((punctured >> m_bssPrimary) & 1U))
+        {
+            NS_LOG_DEBUG("Invalid puncturing pattern, ignored");
+            punctured = 0;
+        }
+    }
+
+    const uint32_t all = (nUnits >= 32) ? ~0U : ((1U << nUnits) - 1);
+    // Eq. (2): A = (U \ N) u P (per-unit CCA is then performed by the PHY on the NPCA channel)
+    uint32_t available = ((all & ~nominal) | punctured) & ~uint32_t{m_disabledBitmap} &
+                         ~(1U << m_bssPrimary);
+    if (m_npcaPrimary >= nUnits || !((available >> m_npcaPrimary) & 1U))
+    {
+        reason = m_punctureAware ? "NPCA primary occupied (O = N \\ P)"
+                                 : "NPCA primary occupied (CH_BANDWIDTH)";
+        return std::nullopt;
+    }
+    // Eq. (3) restricted to unpunctured aligned channels: the largest primary channel around
+    // the NPCA primary 20 MHz channel that lies in A
+    for (int w = nUnits; w >= 1; w /= 2)
+    {
+        const int base = (m_npcaPrimary / w) * w;
+        const uint32_t block = ((w >= 32) ? ~0U : ((1U << w) - 1)) << base;
+        if ((block & ~available) == 0)
+        {
+            return MHz_u{20.0 * w};
+        }
+    }
+    reason = "no NPCA channel";
+    return std::nullopt;
+}
+
+void
+NpcaManager::NotifyPreamble(Ptr<const WifiPpdu> ppdu, Time ppduEnd, bool sigOk)
+{
+    NS_LOG_FUNCTION(this << ppdu << ppduEnd << sigOk);
+    if (!m_enabled || m_active || !sigOk)
+    {
+        return;
+    }
+    auto staMac = DynamicCast<StaWifiMac>(m_mac);
+    if (staMac && (!staMac->IsAssociated() || (m_followAp && !m_apEnabled)))
+    {
+        return;
+    }
+    // inter-BSS classification from the BSS color of HE-SIG-A / U-SIG
+    const auto rxColor = ppdu->GetTxVector().GetBssColor();
+    const auto heConfig = m_mac->GetHeConfiguration();
+    const uint8_t myColor = heConfig ? heConfig->m_bssColor : 0;
+    if (rxColor == 0 || myColor == 0 || rxColor == myColor)
+    {
+        return; // intra-BSS or unknown: not a causal inter-BSS PPDU
+    }
+
+    const auto now = Simulator::Now();
+    auto phy = m_mac->GetWifiPhy(SINGLE_LINK_OP_ID);
+    auto fem = m_mac->GetFrameExchangeManager(SINGLE_LINK_OP_ID);
+    if (phy->IsStateTx() || fem->GetWifiTxTimer().IsRunning())
+    {
+        Reject("frame exchange in progress");
+        return;
+    }
+    if (auto heFem = DynamicCast<HeFrameExchangeManager>(fem);
+        heFem && heFem->GetIntraBssNavEnd() > now)
+    {
+        Reject("intra-BSS NAV set");
+        return;
+    }
+    // NPCA_PPDU_REM_DUR minus the switching and switching back delays must exceed the NPCA
+    // minimum duration (37.18.3 condition 1.c.i)
+    const auto remDur = ppduEnd - now;
+    const auto minDuration = MicroSeconds(512 + 128 * m_minDurationField);
+    if (remDur - m_switchingDelay - m_switchBackDelay <= minDuration)
+    {
+        Reject("below minimum duration threshold");
+        return;
+    }
+    std::string reason;
+    auto width = ComputeNpcaWidth(ppdu, reason);
+    if (!width)
+    {
+        Reject(reason);
+        return;
+    }
+    // the switch is initiated at the NPCA HE switch time (now); do not switch channel from
+    // within the PHY reception processing
+    m_active = true;
+    Simulator::ScheduleNow(&NpcaManager::Start, this, ppduEnd, *width);
+}
+
+void
+NpcaManager::Start(Time ppduEnd, MHz_u width)
+{
+    const auto now = Simulator::Now();
+    auto phy = m_mac->GetWifiPhy(SINGLE_LINK_OP_ID);
+    auto fem = m_mac->GetFrameExchangeManager(SINGLE_LINK_OP_ID);
+    auto cam = m_mac->GetChannelAccessManager(SINGLE_LINK_OP_ID);
+    // NPCA_TIMER = NPCA_PPDU_REM_DUR - switching delay - switching back delay, started when
+    // the switch completes: it expires one switching back delay before the causal PPDU ends
+    const auto timerExpiry = ppduEnd - m_switchBackDelay;
+
+    fem->SetNpcaTxopEnd(timerExpiry);
+    fem->SetNpcaIcfRequired(m_icf);
+    cam->SetNpcaInitialQsrc(m_initialQsrc);
+    cam->SetNpcaMaxWidth(width);
+    if (!phy->SwitchPrimary20ForNpca(m_npcaPrimary, m_switchingDelay))
+    {
+        fem->SetNpcaTxopEnd(std::nullopt);
+        fem->SetNpcaIcfRequired(false);
+        cam->SetNpcaMaxWidth(std::nullopt);
+        m_active = false;
+        Reject("PHY cannot switch");
+        return;
+    }
+    ++m_nStarted;
+    NS_LOG_DEBUG("NPCA start: primary " << +m_npcaPrimary << " width " << width
+                                        << " NPCA_TIMER expires at " << timerExpiry.As(Time::US));
+    m_npcaStartTrace(ppduEnd, m_npcaPrimary, width);
+    m_switchBackEvent = Simulator::Schedule(timerExpiry - now, &NpcaManager::SwitchBack, this);
+}
+
+void
+NpcaManager::SwitchBack()
+{
+    NS_LOG_FUNCTION(this);
+    auto phy = m_mac->GetWifiPhy(SINGLE_LINK_OP_ID);
+    auto fem = m_mac->GetFrameExchangeManager(SINGLE_LINK_OP_ID);
+    auto cam = m_mac->GetChannelAccessManager(SINGLE_LINK_OP_ID);
+    fem->SetNpcaTxopEnd(std::nullopt);
+    fem->SetNpcaIcfRequired(false);
+    cam->SetNpcaMaxWidth(std::nullopt);
+    phy->SwitchPrimary20ForNpca(m_bssPrimary, m_switchBackDelay);
+    Simulator::Schedule(m_switchBackDelay, [this]() {
+        m_active = false;
+        m_npcaEndTrace(Simulator::Now());
+    });
+}
+
+} // namespace ns3
diff --git a/src/wifi/model/uhr/npca-manager.h b/src/wifi/model/uhr/npca-manager.h
new file mode 100644
index 0000000..0451dea
--- /dev/null
+++ b/src/wifi/model/uhr/npca-manager.h
@@ -0,0 +1,184 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#ifndef NPCA_MANAGER_H
+#define NPCA_MANAGER_H
+
+#include "uhr-operation.h"
+
+#include "ns3/event-id.h"
+#include "ns3/nstime.h"
+#include "ns3/object.h"
+#include "ns3/traced-callback.h"
+#include "ns3/wifi-export.h"
+#include "ns3/wifi-units.h"
+
+#include <map>
+#include <optional>
+#include <string>
+
+namespace ns3
+{
+
+class WifiMac;
+class WifiPhy;
+class WifiPpdu;
+
+/**
+ * @ingroup wifi
+ *
+ * Non-Primary Channel Access (NPCA, IEEE P802.11bn) for a single-link AP or non-AP STA,
+ * with the optional puncture-aware occupancy test of "Puncture-Aware Non-Primary Channel
+ * Access" (VTC 2027-Spring).
+ *
+ * PHYLEN NPCA (IEEE P802.11bn D2.0, 37.18). When HE-SIG-A / U-SIG of a PPDU received on the
+ * BSS primary channel has been decoded, condition 1) of 37.18.3 is checked:
+ *  - the PPDU is inter-BSS (BSS color differs from the BSS color of this device);
+ *  - NPCA_PPDU_REM_DUR minus the NPCA switching delay and the NPCA switching back delay is
+ *    greater than the NPCA minimum duration (512 + NMDT x 128 us);
+ *  - the channel occupied by the PPDU does not overlap with the NPCA primary channel. The
+ *    occupied channel is given by CH_BANDWIDTH (D2.0) or, with PunctureAware, by
+ *    CH_BANDWIDTH minus INACTIVE_SUBCHANNELS (O = N \ P; P is used only if it is a valid
+ *    non-OFDMA 802.11be puncturing pattern);
+ *  - the intra-BSS NAV is zero (and no frame exchange of this device is in progress).
+ *
+ * The switch is initiated at the NPCA HE switch time (end of HE-SIG-A / U-SIG) and completes
+ * after the NPCA switching delay (WifiPhy::SwitchPrimary20ForNpca). Then (37.18.4):
+ *  - NPCA_TIMER = NPCA_PPDU_REM_DUR - switching delay - switching back delay starts;
+ *  - every EDCAF stores QSRC, CW and its backoff counter, sets QSRC to the Initial NPCA QSRC,
+ *    CW to 2^QSRC (CWmin + 1) - 1 and draws a new backoff (rule 12)a, 12)b); the same EDCA
+ *    parameter set is used; CCA is performed by the PHY on the NPCA primary channel;
+ *  - every frame exchange starts with an initial Control frame (rule 8)): a non-AP STA sends
+ *    a BSRP NTB Trigger frame, answered by a Multi-STA BlockAck frame in ICR context, an AP
+ *    sends an MU-RTS Trigger frame, answered by CTS; RTS frames are not used; the NPCA
+ *    Primary Channel Indication of these Trigger frames is set to 1 (rule 10));
+ *  - the transmitted PPDUs include the NPCA primary channel, exclude the channels occupied
+ *    by the causal PPDU and those in the NPCA Disabled Subchannel Bitmap (rule 11));
+ *  - Beacon and Probe frames are deferred until the switch back (rules 14), 17));
+ *  - frame exchanges end by the expiration of NPCA_TIMER, when the device switches back to
+ *    the BSS primary channel and restores the stored EDCAF state (37.18.5).
+ *
+ * An AP advertises NPCA in the UHR Operation element (NPCA Enabled; NPCA Operation
+ * Parameters in Probe and (Re)Association Response frames); a STA applies them (FollowAp).
+ */
+class WIFI_EXPORT NpcaManager : public Object
+{
+  public:
+    /**
+     * @brief Get the type ID.
+     * @return the object TypeId
+     */
+    static TypeId GetTypeId();
+
+    NpcaManager();
+    ~NpcaManager() override;
+
+    /**
+     * @param mac the MAC this manager operates for (link 0)
+     */
+    void SetWifiMac(Ptr<WifiMac> mac);
+
+    /**
+     * @param includeParameters whether to include the NPCA Operation Parameters field (it is
+     *        not included in Beacon frames)
+     * @return the UHR Operation element advertised by an AP
+     */
+    UhrOperation GetUhrOperation(bool includeParameters) const;
+
+    /**
+     * Apply the NPCA parameters advertised by the associated AP.
+     * @param op the UHR Operation element
+     */
+    void ApplyUhrOperation(const UhrOperation& op);
+
+    /// @return whether this device currently operates on the NPCA channel
+    bool IsActive() const;
+
+    /// @return whether the AP advertises NPCA parameters
+    bool GetAdvertise() const;
+
+    /// @return number of NPCA operations started
+    uint64_t GetNStarted() const;
+
+    /// @return number of evaluations that did not lead to NPCA, per reason
+    const std::map<std::string, uint64_t>& GetRejections() const;
+
+    /**
+     * Compute the occupied and available 20 MHz channels for a causal PPDU and the resulting
+     * maximum NPCA PPDU width (exposed for testing).
+     *
+     * @param ppdu the causal PPDU
+     * @param[out] reason why NPCA is not possible (if it is not)
+     * @return the maximum NPCA PPDU width, or std::nullopt if NPCA is not possible
+     */
+    std::optional<MHz_u> ComputeNpcaWidth(Ptr<const WifiPpdu> ppdu, std::string& reason) const;
+
+    /**
+     * TracedCallback signature for NPCA start.
+     * @param obssPpduEnd end of the causal PPDU
+     * @param npcaPrimary index of the NPCA primary 20 MHz channel
+     * @param width maximum NPCA PPDU width
+     */
+    typedef void (*NpcaStartCallback)(Time obssPpduEnd, uint8_t npcaPrimary, MHz_u width);
+
+  protected:
+    void DoInitialize() override;
+    void DoDispose() override;
+
+  private:
+    /**
+     * Callback from HePhy/EhtPhy at the end of HE-SIG-A / U-SIG.
+     * @param ppdu the PPDU
+     * @param ppduEnd the time the PPDU ends
+     * @param sigOk whether the field was decoded successfully
+     */
+    void NotifyPreamble(Ptr<const WifiPpdu> ppdu, Time ppduEnd, bool sigOk);
+
+    /**
+     * Switch to the NPCA primary channel.
+     * @param ppduEnd end of the causal PPDU
+     * @param width maximum NPCA PPDU width
+     */
+    void Start(Time ppduEnd, MHz_u width);
+
+    /// @return the channel number of the 20 MHz channel with the given index
+    /// @param index the index of the 20 MHz channel within the operating channel
+    uint8_t GetChannelNumber(uint8_t index) const;
+
+    /// Switch back to the BSS primary channel (NPCA timer expired)
+    void SwitchBack();
+
+    /// @param reason the rejection reason
+    void Reject(const std::string& reason);
+
+    Ptr<WifiMac> m_mac;          //!< the MAC
+    bool m_enabled;              //!< NPCA enabled on this device
+    bool m_punctureAware;        //!< use O = N \ P
+    uint8_t m_npcaPrimary;       //!< NPCA primary 20 MHz index
+    Time m_switchingDelay;       //!< NPCA switching delay
+    Time m_switchBackDelay;      //!< NPCA switching back delay
+    uint8_t m_minDurationField;  //!< NPCA Minimum Duration Threshold field (NMDT)
+    uint8_t m_initialQsrc;       //!< Initial NPCA QSRC
+    uint16_t m_disabledBitmap;   //!< NPCA Disabled Subchannel Bitmap (0: not present)
+    bool m_icf;                  //!< use an initial control frame exchange
+    bool m_advertise;            //!< AP: advertise UHR Operation
+    bool m_followAp;             //!< STA: apply the AP's parameters
+    bool m_apEnabled;            //!< STA: the AP advertised NPCA as enabled
+
+    bool m_active{false};        //!< operating on the NPCA channel (or switching back)
+    uint8_t m_bssPrimary{0};     //!< BSS primary 20 MHz index
+    EventId m_switchBackEvent;   //!< NPCA timer
+    uint64_t m_nStarted{0};      //!< statistics
+    std::map<std::string, uint64_t> m_rejections; //!< statistics
+
+    TracedCallback<Time, uint8_t, MHz_u> m_npcaStartTrace; //!< NPCA started
+    TracedCallback<Time> m_npcaEndTrace;                   //!< switched back
+    TracedCallback<std::string> m_npcaRejectTrace;         //!< not started
+};
+
+} // namespace ns3
+
+#endif /* NPCA_MANAGER_H */
diff --git a/src/wifi/model/uhr/uhr-operation.cc b/src/wifi/model/uhr/uhr-operation.cc
new file mode 100644
index 0000000..8de93b0
--- /dev/null
+++ b/src/wifi/model/uhr/uhr-operation.cc
@@ -0,0 +1,108 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include "uhr-operation.h"
+
+namespace ns3
+{
+
+WifiInformationElementId
+UhrOperation::ElementId() const
+{
+    return IE_EXTENSION;
+}
+
+WifiInformationElementId
+UhrOperation::ElementIdExt() const
+{
+    return IE_EXT_UHR_OPERATION;
+}
+
+void
+UhrOperation::Print(std::ostream& os) const
+{
+    os << "NPCA enabled=" << m_npcaEnabled;
+    if (m_npcaParams)
+    {
+        os << " primary=" << +m_npcaParams->primaryChannel
+           << " minDuration=" << m_npcaParams->GetMinDurationUs()
+           << "us switchingDelay=" << 4 * m_npcaParams->switchingDelay
+           << "us switchingBackDelay=" << 4 * m_npcaParams->switchingBackDelay
+           << "us initialQsrc=" << +m_npcaParams->initialQsrc << " moplen=" << m_npcaParams->moplen;
+        if (m_npcaParams->disabledSubchannelBitmap)
+        {
+            os << " disabledBm=" << std::hex << *m_npcaParams->disabledSubchannelBitmap << std::dec;
+        }
+    }
+}
+
+uint16_t
+UhrOperation::GetInformationFieldSize() const
+{
+    uint16_t size = WIFI_IE_ELEMENT_ID_EXT_SIZE + 2; // UHR Operation Control
+    if (m_npcaParams)
+    {
+        size += m_npcaParams->disabledSubchannelBitmap ? 6 : 4;
+    }
+    return size;
+}
+
+void
+UhrOperation::SerializeInformationField(Buffer::Iterator start) const
+{
+    // UHR Operation Control field (Figure 9-aa2): B1 NPCA Enabled, B10 NPCA Operation
+    // Parameters Present
+    uint16_t control = 0;
+    control |= (m_npcaEnabled ? 1 : 0) << 1;
+    control |= (m_npcaParams ? 1 : 0) << 10;
+    start.WriteU16(control);
+    if (!m_npcaParams)
+    {
+        return;
+    }
+    // NPCA Operation Parameters field (Figure 9-aa4)
+    const auto& p = *m_npcaParams;
+    uint32_t params = p.primaryChannel;
+    params |= static_cast<uint32_t>(p.minDurationThreshold & 0x0f) << 8;
+    params |= static_cast<uint32_t>(p.switchingDelay & 0x3f) << 12;
+    params |= static_cast<uint32_t>(p.switchingBackDelay & 0x3f) << 18;
+    params |= static_cast<uint32_t>(p.initialQsrc & 0x03) << 24;
+    params |= static_cast<uint32_t>(p.moplen ? 1 : 0) << 26;
+    params |= static_cast<uint32_t>(p.disabledSubchannelBitmap ? 1 : 0) << 27;
+    start.WriteU32(params);
+    if (p.disabledSubchannelBitmap)
+    {
+        start.WriteU16(*p.disabledSubchannelBitmap);
+    }
+}
+
+uint16_t
+UhrOperation::DeserializeInformationField(Buffer::Iterator start, uint16_t length)
+{
+    auto i = start;
+    const auto control = i.ReadU16();
+    m_npcaEnabled = (control >> 1) & 1;
+    m_npcaParams.reset();
+    if ((control >> 10) & 1)
+    {
+        const auto params = i.ReadU32();
+        NpcaOperationParameters p;
+        p.primaryChannel = params & 0xff;
+        p.minDurationThreshold = (params >> 8) & 0x0f;
+        p.switchingDelay = (params >> 12) & 0x3f;
+        p.switchingBackDelay = (params >> 18) & 0x3f;
+        p.initialQsrc = (params >> 24) & 0x03;
+        p.moplen = (params >> 26) & 1;
+        if ((params >> 27) & 1)
+        {
+            p.disabledSubchannelBitmap = i.ReadU16();
+        }
+        m_npcaParams = p;
+    }
+    return i.GetDistanceFrom(start);
+}
+
+} // namespace ns3
diff --git a/src/wifi/model/uhr/uhr-operation.h b/src/wifi/model/uhr/uhr-operation.h
new file mode 100644
index 0000000..c465a22
--- /dev/null
+++ b/src/wifi/model/uhr/uhr-operation.h
@@ -0,0 +1,68 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#ifndef UHR_OPERATION_H
+#define UHR_OPERATION_H
+
+#include "ns3/wifi-export.h"
+#include "ns3/wifi-information-element.h"
+
+#include <optional>
+
+namespace ns3
+{
+
+/// Element ID Extension of the UHR Operation element (IEEE P802.11bn D2.0, Table 9-128)
+#define IE_EXT_UHR_OPERATION ((WifiInformationElementId)151)
+
+/**
+ * @ingroup wifi
+ * UHR Operation element (IEEE P802.11bn D2.0, 9.4.2.360).
+ *
+ * Only the NPCA related fields are modelled: the NPCA Enabled and NPCA Operation Parameters
+ * Present subfields of the UHR Operation Control field and the NPCA Operation Parameters field
+ * (Figure 9-aa4). The other subfields of the UHR Operation Control field are set to 0 and the
+ * other (optional) fields of the UHR Operation Parameters field are not present.
+ */
+class WIFI_EXPORT UhrOperation : public WifiInformationElement
+{
+  public:
+    /// NPCA Operation Parameters field (Figure 9-aa4)
+    struct NpcaOperationParameters
+    {
+        uint8_t primaryChannel{0};      ///< NPCA Primary Channel (channel number)
+        uint8_t minDurationThreshold{0}; ///< NPCA Minimum Duration Threshold (4 bits)
+        uint8_t switchingDelay{0};      ///< NPCA Switching Delay, units of 4 us (6 bits)
+        uint8_t switchingBackDelay{0};  ///< NPCA Switching Back Delay, units of 4 us (6 bits)
+        uint8_t initialQsrc{0};         ///< Initial NPCA QSRC (2 bits)
+        bool moplen{false};             ///< MOPLEN NPCA
+        std::optional<uint16_t> disabledSubchannelBitmap; ///< NPCA Disabled Subchannel Bitmap
+
+        /// @return the minimum duration (512 + NMDT x 128 us), in microseconds
+        uint32_t GetMinDurationUs() const
+        {
+            return 512 + 128U * minDurationThreshold;
+        }
+    };
+
+    UhrOperation() = default;
+
+    WifiInformationElementId ElementId() const override;
+    WifiInformationElementId ElementIdExt() const override;
+    void Print(std::ostream& os) const override;
+
+    bool m_npcaEnabled{false};                         ///< NPCA Enabled
+    std::optional<NpcaOperationParameters> m_npcaParams; ///< NPCA Operation Parameters field
+
+  private:
+    uint16_t GetInformationFieldSize() const override;
+    void SerializeInformationField(Buffer::Iterator start) const override;
+    uint16_t DeserializeInformationField(Buffer::Iterator start, uint16_t length) override;
+};
+
+} // namespace ns3
+
+#endif /* UHR_OPERATION_H */
