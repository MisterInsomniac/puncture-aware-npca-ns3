+void
+WifiRemoteStationManager::ApplyNonOfdmaPuncturing(WifiTxVector& txVector) const
+{
+    auto ehtConfiguration = m_wifiPhy->GetDevice()->GetEhtConfiguration();
+    if (!ehtConfiguration || ehtConfiguration->m_nonOfdmaPuncturingBitmap == 0 ||
+        txVector.GetPreambleType() != WIFI_PREAMBLE_EHT_MU || txVector.IsMu())
+    {
+        return;
+    }
+    const auto width = txVector.GetChannelWidth();
+    if (width < MHz_u{80} || width > MHz_u{160})
+    {
+        return;
+    }
+    const auto& channel = m_wifiPhy->GetOperatingChannel();
+    const auto indices = channel.GetAll20MHzChannelIndicesInPrimary(width);
+    const auto p20Index = channel.GetPrimaryChannelIndex(MHz_u{20});
+    std::vector<bool> inactive;
+    std::size_t count = 0;
+    std::size_t first = 0;
+    for (const auto idx : indices)
+    {
+        const bool punct = (ehtConfiguration->m_nonOfdmaPuncturingBitmap >> idx) & 1;
+        if (punct && idx == p20Index)
+        {
+            return; // the primary 20 MHz channel cannot be punctured
+        }
+        if (punct && count++ == 0)
+        {
+            first = inactive.size();
+        }
+        inactive.push_back(punct);
+    }
+    const bool valid = (count == 1) || (count == 2 && first % 2 == 0 && inactive.at(first + 1));
+    if (!valid)
+    {
+        return;
+    }
+    if (ehtConfiguration->m_puncturingRv->GetValue() >= ehtConfiguration->m_nonOfdmaPuncturingProb)
+    {
+        return;
+    }
+    txVector.SetInactiveSubchannels(inactive);
+}
