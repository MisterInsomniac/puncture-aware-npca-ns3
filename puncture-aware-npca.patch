+uint8_t
+NpcaManager::GetChannelNumber(uint8_t index) const
+{
+    const auto& op = m_mac->GetWifiPhy(SINGLE_LINK_OP_ID)->GetOperatingChannel();
+    const auto nUnits = static_cast<int>(op.GetTotalWidth() / MHz_u{20});
+    // in the 5 GHz and 6 GHz bands, 20 MHz channel numbers increase by 4
+    return static_cast<uint8_t>(op.GetNumber() - 2 * (nUnits - 1) + 4 * index);
+}
+
+UhrOperation
+NpcaManager::GetUhrOperation(bool includeParameters) const
+{
+    UhrOperation op;
+    op.m_npcaEnabled = m_enabled;
+    if (m_enabled && includeParameters)
+    {
+        UhrOperation::NpcaOperationParameters p;
+        p.primaryChannel = GetChannelNumber(m_npcaPrimary);
+        p.minDurationThreshold = m_minDurationField;
+        p.switchingDelay = static_cast<uint8_t>(m_switchingDelay.GetMicroSeconds() / 4);
+        p.switchingBackDelay = static_cast<uint8_t>(m_switchBackDelay.GetMicroSeconds() / 4);
+        p.initialQsrc = m_initialQsrc;
+        p.moplen = false; // PHYLEN NPCA only
+        if (m_disabledBitmap != 0)
+        {
+            // the bit of the BSS primary 20 MHz channel is set to 1 (37.18.1)
+            p.disabledSubchannelBitmap = m_disabledBitmap | (1U << m_bssPrimary);
+        }
+        op.m_npcaParams = p;
+    }
+    return op;
+}
+
+void
+NpcaManager::ApplyUhrOperation(const UhrOperation& op)
+{
+    NS_LOG_FUNCTION(this << op);
+    if (!m_followAp)
+    {
+        return;
+    }
+    m_apEnabled = op.m_npcaEnabled;
+    if (!op.m_npcaParams)
+    {
+        return; // Beacon frames do not carry the NPCA Operation Parameters field
+    }
+    const auto& p = *op.m_npcaParams;
+    const auto lowest = GetChannelNumber(0);
+    NS_ABORT_MSG_IF(p.primaryChannel < lowest || (p.primaryChannel - lowest) % 4 != 0,
+                    "Invalid NPCA Primary Channel " << +p.primaryChannel);
+    m_npcaPrimary = (p.primaryChannel - lowest) / 4;
+    m_minDurationField = p.minDurationThreshold;
+    m_switchingDelay = MicroSeconds(4 * p.switchingDelay);
+    m_switchBackDelay = MicroSeconds(4 * p.switchingBackDelay);
+    m_initialQsrc = p.initialQsrc;
+    m_disabledBitmap = p.disabledSubchannelBitmap.value_or(0);
+}
