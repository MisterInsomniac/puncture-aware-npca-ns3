+/**
+ * @ingroup wifi-test
+ * Non-OFDMA Punctured Channel Information (U-SIG) encoding and decoding.
+ */
+class EhtNonOfdmaPuncturingTest : public TestCase
+{
+  public:
+    EhtNonOfdmaPuncturingTest()
+        : TestCase("EHT non-OFDMA punctured channel information round trip")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        for (MHz_u width : {MHz_u{80}, MHz_u{160}})
+        {
+            const auto n = static_cast<std::size_t>(width / MHz_u{20});
+            std::vector<std::vector<bool>> patterns;
+            for (std::size_t i = 0; i < n; ++i)
+            {
+                std::vector<bool> p(n, false);
+                p[i] = true;
+                patterns.push_back(p);
+            }
+            if (width == MHz_u{160})
+            {
+                for (std::size_t i = 0; i < n; i += 2)
+                {
+                    std::vector<bool> p(n, false);
+                    p[i] = p[i + 1] = true;
+                    patterns.push_back(p);
+                }
+            }
+            for (const auto& p : patterns)
+            {
+                const auto info = EhtPpdu::GetPuncturedInfo(p, 1 /* EHT SU */, std::nullopt);
+                NS_TEST_EXPECT_MSG_NE(+info, 0, "pattern must be signalled");
+                NS_TEST_EXPECT_MSG_EQ((EhtPpdu::GetInactiveSubchannelsFromPuncturedInfo(info,
+                                                                                         width) ==
+                                       p),
+                                      true,
+                                      "round trip of punctured channel information");
+            }
+        }
+    }
+};
