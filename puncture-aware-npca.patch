+ *
+ * An OBSS AP sends 80 MHz EHT PPDUs on channel 42 that puncture the 20 MHz channel with index
+ * 2 (channel 44). BSS-A (BSS color 1) advertises NPCA primary channel 44. Standard NPCA must
+ * reject every OBSS PPDU (CH_BANDWIDTH covers the NPCA primary channel). With puncture-aware
+ * NPCA the test checks that:
+ *  - the STA adopts the NPCA parameters advertised by the AP;
+ *  - on the NPCA primary channel, the STA starts every TXOP with a BSRP NTB Trigger frame
+ *    (NPCA Primary Channel Indication = 1, no RTS) and the AP with an MU-RTS Trigger frame
+ *    (NPCA Primary Channel Indication = 1); the AP answers BSRP NTB with an ICR;
+ *  - NPCA PPDUs exclude the occupied channels (20 MHz here);
+ *  - the AP sends no Beacon while operating on the NPCA primary channel;
+ *  - at the end of every switch to the NPCA primary channel the EDCAF sets CW to
+ *    2^InitialQsrc x (CWmin + 1) - 1 and draws a new backoff, and at the end of every switch
+ *    back it restores the stored CW.
+ */
+class WifiNpcaEndToEndTest : public TestCase
+{
+  public:
+    /**
+     * @param punctureAware whether BSS-A uses puncture-aware NPCA
+     */
+    WifiNpcaEndToEndTest(bool punctureAware)
+        : TestCase(std::string("NPCA end-to-end, ") +
+                   (punctureAware ? "puncture-aware" : "standard")),
+          m_punctureAware(punctureAware)
+    {
+    }
+
+  private:
+    void DoRun() override;
+
+    /// Transmissions of BSS-A STA 0
+    void StaTx(WifiConstPsduMap psdus, WifiTxVector txVector, double);
+    /// Transmissions of the BSS-A AP
+    void ApTx(WifiConstPsduMap psdus, WifiTxVector txVector, double);
+    /// CW trace of STA 0 (AC_BE)
+    void StaCw(uint32_t cw, uint8_t linkId);
+    /// Backoff trace of STA 0 (AC_BE)
+    void StaBackoff(uint32_t backoff, uint8_t linkId);
+    /// NPCA start at STA 0
+    void StaNpcaStart(Time obssEnd, uint8_t primary, MHz_u width);
+    /// NPCA end at STA 0
+    void StaNpcaEnd(Time now);
+
+    bool m_punctureAware;          ///< scheme under test
+    Ptr<NpcaManager> m_staNpca;    ///< NPCA manager of STA 0
+    Ptr<NpcaManager> m_apNpca;     ///< NPCA manager of the AP
+    Time m_switchingDelay{MicroSeconds(100)}; ///< NPCA switching delay
+    uint8_t m_initialQsrc{1};      ///< Initial NPCA QSRC advertised by the AP
+    uint32_t m_cwMin{15};          ///< CWmin of AC_BE
+
+    uint32_t m_staIcf{0};          ///< BSRP NTB Trigger frames sent by STA 0 on NPCA
+    uint32_t m_staIcfBadInd{0};    ///< ... without NPCA Primary Channel Indication
+    uint32_t m_staRts{0};          ///< RTS frames sent by STA 0 on NPCA (must be 0)
+    uint32_t m_staData{0};         ///< data PPDUs sent by STA 0 on NPCA
+    uint32_t m_staWideData{0};     ///< ... wider than 20 MHz (must be 0)
+    uint32_t m_staDataNoIcf{0};    ///< ... not preceded by an ICF in the same TXOP
+    bool m_staIcfSeen{false};      ///< ICF sent since the last data frame
+    uint32_t m_apMuRts{0};         ///< MU-RTS Trigger frames sent by the AP on NPCA
+    uint32_t m_apMuRtsBadInd{0};   ///< ... without NPCA Primary Channel Indication
+    uint32_t m_apRts{0};           ///< RTS sent by the AP on NPCA (must be 0)
+    uint32_t m_apIcr{0};           ///< ICRs sent by the AP
+    uint32_t m_apData{0};          ///< data PPDUs sent by the AP on NPCA
+    uint32_t m_apBeaconOnNpca{0};  ///< Beacon frames sent on NPCA (must be 0)
+    std::vector<std::pair<Time, uint32_t>> m_cw;      ///< CW trace of STA 0
+    std::vector<Time> m_backoff;                      ///< backoff trace of STA 0
+    std::vector<Time> m_npcaStart;                    ///< NPCA start times of STA 0
+    std::vector<Time> m_npcaEnd;                      ///< NPCA end times of STA 0
+};
+
+void
+WifiNpcaEndToEndTest::StaTx(WifiConstPsduMap psdus, WifiTxVector txVector, double)
+{
+    if (!m_staNpca->IsActive())
+    {
+        m_staIcfSeen = false;
+        return;
+    }
+    auto mpdu = *psdus.begin()->second->begin();
+    const auto& hdr = mpdu->GetHeader();
+    if (hdr.IsRts())
+    {
+        ++m_staRts;
+    }
+    else if (hdr.IsTrigger())
+    {
+        CtrlTriggerHeader trigger;
+        mpdu->GetPacket()->PeekHeader(trigger);
+        if (trigger.IsBsrpNtb())
+        {
+            ++m_staIcf;
+            m_staIcfBadInd += trigger.GetNpcaPrimaryChannelIndication() ? 0 : 1;
+            m_staIcfSeen = true;
+        }
+    }
+    else if (hdr.IsQosData())
+    {
+        ++m_staData;
+        m_staWideData += (txVector.GetChannelWidth() > MHz_u{20}) ? 1 : 0;
+        m_staDataNoIcf += m_staIcfSeen ? 0 : 1;
+        m_staIcfSeen = false; // TXOP limit 0: one data exchange per TXOP
+    }
+}
+
+void
+WifiNpcaEndToEndTest::ApTx(WifiConstPsduMap psdus, WifiTxVector txVector, double)
+{
+    auto mpdu = *psdus.begin()->second->begin();
+    const auto& hdr = mpdu->GetHeader();
+    if (hdr.IsBlockAck())
+    {
+        CtrlBAckResponseHeader ba;
+        mpdu->GetPacket()->PeekHeader(ba);
+        if (ba.IsMultiSta() && ba.GetAckType(0) &&
+            ba.GetTidInfo(0) == FrameExchangeManager::ICR_CONTEXT_TID)
+        {
+            ++m_apIcr;
+        }
+    }
+    if (!m_apNpca->IsActive())
+    {
+        return;
+    }
+    if (hdr.IsBeacon())
+    {
+        ++m_apBeaconOnNpca;
+    }
+    else if (hdr.IsRts())
+    {
+        ++m_apRts;
+    }
+    else if (hdr.IsTrigger())
+    {
+        CtrlTriggerHeader trigger;
+        mpdu->GetPacket()->PeekHeader(trigger);
+        if (trigger.IsMuRts())
+        {
+            ++m_apMuRts;
+            m_apMuRtsBadInd += trigger.GetNpcaPrimaryChannelIndication() ? 0 : 1;
+        }
+    }
+    else if (hdr.IsQosData())
+    {
+        ++m_apData;
+    }
+}
+
+void
+WifiNpcaEndToEndTest::StaCw(uint32_t cw, uint8_t)
+{
+    m_cw.emplace_back(Simulator::Now(), cw);
+}
+
+void
+WifiNpcaEndToEndTest::StaBackoff(uint32_t, uint8_t)
+{
+    m_backoff.push_back(Simulator::Now());
+}
+
+void
+WifiNpcaEndToEndTest::StaNpcaStart(Time, uint8_t, MHz_u)
+{
+    m_npcaStart.push_back(Simulator::Now());
+}
+
+void
+WifiNpcaEndToEndTest::StaNpcaEnd(Time now)
+{
+    m_npcaEnd.push_back(now);
+}
+
+void
+WifiNpcaEndToEndTest::DoRun()
+{
+    RngSeedManager::SetSeed(1);
+    RngSeedManager::SetRun(3);
+    NodeContainer nodes(5); // OBSS AP, OBSS STA, BSS-A AP, 2 BSS-A STAs
+
+    auto channel = CreateObject<MultiModelSpectrumChannel>();
+    auto loss = CreateObject<LogDistancePropagationLossModel>();
+    loss->SetAttribute("Exponent", DoubleValue(3.0));
+    loss->SetAttribute("ReferenceLoss", DoubleValue(46.7));
+    channel->AddPropagationLossModel(loss);
+    SpectrumWifiPhyHelper phy;
+    phy.SetChannel(channel);
+    phy.Set("ChannelSettings", StringValue("{42, 80, BAND_5GHZ, 0}"));
+    WifiHelper wifi;
+    wifi.SetStandard(WIFI_STANDARD_80211be);
+    wifi.SetRemoteStationManager("ns3::ConstantRateWifiManager",
+                                 "DataMode",
+                                 StringValue("EhtMcs3"),
+                                 "ControlMode",
+                                 StringValue("OfdmRate24Mbps"));
+    Config::SetDefault("ns3::WifiMac::BE_MaxAmpduSize", UintegerValue(6500631));
+
+    WifiMacHelper mac;
+    mac.SetType("ns3::ApWifiMac", "Ssid", SsidValue(Ssid("obss")));
+    auto obssAp = wifi.Install(phy, mac, nodes.Get(0));
+    mac.SetType("ns3::StaWifiMac", "Ssid", SsidValue(Ssid("obss")));
+    auto obssSta = wifi.Install(phy, mac, nodes.Get(1));
+    mac.SetType("ns3::ApWifiMac", "Ssid", SsidValue(Ssid("bss-a")));
+    auto apA = wifi.Install(phy, mac, nodes.Get(2));
+    mac.SetType("ns3::StaWifiMac", "Ssid", SsidValue(Ssid("bss-a")));
+    auto staA = wifi.Install(phy, mac, NodeContainer(nodes.Get(3), nodes.Get(4)));
+
+    DynamicCast<WifiNetDevice>(obssAp.Get(0))->GetHeConfiguration()->m_bssColor = 2;
+    DynamicCast<WifiNetDevice>(apA.Get(0))->GetHeConfiguration()->m_bssColor = 1;
+    auto obssEht = DynamicCast<WifiNetDevice>(obssAp.Get(0))->GetEhtConfiguration();
+    obssEht->SetAttribute("NonOfdmaPuncturingBitmap", UintegerValue(0b0100));
+    auto be = DynamicCast<WifiNetDevice>(obssAp.Get(0))->GetMac()->GetQosTxop(AC_BE);
+    be->SetMinCw(2, SINGLE_LINK_OP_ID);
+    be->SetMaxCw(2, SINGLE_LINK_OP_ID);
+    be->SetAifsn(2, SINGLE_LINK_OP_ID);
+
+    NetDeviceContainer bssA(apA, staA);
+    for (uint32_t i = 0; i < bssA.GetN(); ++i)
+    {
+        auto npca = CreateObject<NpcaManager>();
+        npca->SetAttribute("PunctureAware", BooleanValue(m_punctureAware));
+        // the AP advertises NPCA primary index 2 and Initial NPCA QSRC 1; the STAs start with
+        // different values and must adopt the advertised ones
+        npca->SetAttribute("NpcaPrimaryChannel", UintegerValue(i == 0 ? 2 : 3));
+        npca->SetAttribute("InitialQsrc", UintegerValue(i == 0 ? m_initialQsrc : 0));
+        npca->SetAttribute("SwitchingDelay", TimeValue(m_switchingDelay));
+        DynamicCast<WifiNetDevice>(bssA.Get(i))->GetMac()->SetNpcaManager(npca);
+    }
+    m_apNpca = DynamicCast<WifiNetDevice>(apA.Get(0))->GetMac()->GetNpcaManager();
+    auto staMac = DynamicCast<WifiNetDevice>(staA.Get(0))->GetMac();
+    m_staNpca = staMac->GetNpcaManager();
+
+    // OBSS 15 m away from BSS-A: OBSS RSSI at BSS-A about -66 dBm
+    MobilityHelper mobility;
+    auto pos = CreateObject<ListPositionAllocator>();
+    pos->Add(Vector(0, 0, 0));
+    pos->Add(Vector(2, 0, 0));
+    pos->Add(Vector(15, 0, 0));
+    pos->Add(Vector(16, 1, 0));
+    pos->Add(Vector(14, 1, 0));
+    mobility.SetPositionAllocator(pos);
+    mobility.SetMobilityModel("ns3::ConstantPositionMobilityModel");
+    mobility.Install(nodes);
+
+    WifiHelper::AssignStreams(NetDeviceContainer(obssAp, obssSta), 0);
+    WifiHelper::AssignStreams(bssA, 100);
+
+    auto obssDev = obssAp.Get(0);
+    auto obssDst = obssSta.Get(0)->GetAddress();
+    for (Time t = MilliSeconds(300); t < MilliSeconds(1000); t += MilliSeconds(7))
+    {
+        Simulator::Schedule(t, [=]() {
+            for (int i = 0; i < 40; ++i)
+            {
+                obssDev->Send(Create<Packet>(1400), obssDst, 0x0800);
+            }
+        });
+    }
+    // UL traffic from both STAs and DL traffic from the AP to STA 0
+    auto apAddr = apA.Get(0)->GetAddress();
+    for (uint32_t s = 0; s < staA.GetN(); ++s)
+    {
+        auto dev = staA.Get(s);
+        for (Time t = MilliSeconds(300); t < MilliSeconds(1000); t += MilliSeconds(2))
+        {
+            Simulator::Schedule(t, [=]() {
+                for (int i = 0; i < 10; ++i)
+                {
+                    dev->Send(Create<Packet>(1400), apAddr, 0x0800);
+                }
+            });
+        }
+    }
+    auto apDev = apA.Get(0);
+    auto sta0Addr = staA.Get(0)->GetAddress();
+    for (Time t = MilliSeconds(300); t < MilliSeconds(1000); t += MilliSeconds(2))
+    {
+        Simulator::Schedule(t, [=]() {
+            for (int i = 0; i < 10; ++i)
+            {
+                apDev->Send(Create<Packet>(1400), sta0Addr, 0x0800);
+            }
+        });
+    }
+
+    staMac->GetWifiPhy()->TraceConnectWithoutContext(
+        "PhyTxPsduBegin",
+        MakeCallback(&WifiNpcaEndToEndTest::StaTx, this));
+    DynamicCast<WifiNetDevice>(apA.Get(0))
+        ->GetPhy()
+        ->TraceConnectWithoutContext("PhyTxPsduBegin",
+                                     MakeCallback(&WifiNpcaEndToEndTest::ApTx, this));
+    auto staBe = staMac->GetQosTxop(AC_BE);
+    m_cwMin = staBe->GetMinCw(SINGLE_LINK_OP_ID);
+    staBe->TraceConnectWithoutContext("CwTrace", MakeCallback(&WifiNpcaEndToEndTest::StaCw, this));
+    staBe->TraceConnectWithoutContext("BackoffTrace",
+                                      MakeCallback(&WifiNpcaEndToEndTest::StaBackoff, this));
+    m_staNpca->TraceConnectWithoutContext("NpcaStart",
+                                          MakeCallback(&WifiNpcaEndToEndTest::StaNpcaStart, this));
+    m_staNpca->TraceConnectWithoutContext("NpcaEnd",
+                                          MakeCallback(&WifiNpcaEndToEndTest::StaNpcaEnd, this));
+
+    Simulator::Stop(Seconds(1));
+    Simulator::Run();
+
+    NS_TEST_EXPECT_MSG_EQ(DynamicCast<StaWifiMac>(staMac)->IsAssociated(), true, "associated");
+    UintegerValue primary;
+    UintegerValue qsrc;
+    m_staNpca->GetAttribute("NpcaPrimaryChannel", primary);
+    m_staNpca->GetAttribute("InitialQsrc", qsrc);
+    NS_TEST_EXPECT_MSG_EQ(primary.Get(), 2, "STA adopted the advertised NPCA primary channel");
+    NS_TEST_EXPECT_MSG_EQ(qsrc.Get(), m_initialQsrc, "STA adopted the Initial NPCA QSRC");
+
+    if (!m_punctureAware)
+    {
+        NS_TEST_EXPECT_MSG_EQ(m_apNpca->GetNStarted(), 0, "standard NPCA must reject");
+        NS_TEST_EXPECT_MSG_EQ(m_staNpca->GetNStarted(), 0, "standard NPCA must reject");
+        NS_TEST_EXPECT_MSG_GT(m_apNpca->GetRejections().size(), 0, "rejections recorded");
+    }
+    else
+    {
+        NS_TEST_EXPECT_MSG_GT(m_apNpca->GetNStarted(), 10, "AP must use NPCA");
+        NS_TEST_EXPECT_MSG_GT(m_staNpca->GetNStarted(), 10, "STA must use NPCA");
+        // initial Control frames (37.18.4 rules 8), 10))
+        NS_TEST_EXPECT_MSG_GT(m_staIcf, 0, "STA sends BSRP NTB Trigger frames on NPCA");
+        NS_TEST_EXPECT_MSG_EQ(m_staIcfBadInd, 0, "NPCA Primary Channel Indication = 1");
+        NS_TEST_EXPECT_MSG_EQ(m_staRts, 0, "no RTS on the NPCA primary channel");
+        NS_TEST_EXPECT_MSG_GT(m_apIcr, 0, "AP answers with ICRs");
+        NS_TEST_EXPECT_MSG_GT(m_staData, 0, "STA sends data on NPCA");
+        NS_TEST_EXPECT_MSG_EQ(m_staDataNoIcf, 0, "every STA TXOP on NPCA starts with an ICF");
+        NS_TEST_EXPECT_MSG_EQ(m_staWideData, 0, "NPCA PPDUs exclude occupied channels");
+        NS_TEST_EXPECT_MSG_GT(m_apMuRts, 0, "AP sends MU-RTS Trigger frames on NPCA");
+        NS_TEST_EXPECT_MSG_EQ(m_apMuRtsBadInd, 0, "MU-RTS with NPCA Primary Channel Indication");
+        NS_TEST_EXPECT_MSG_EQ(m_apRts, 0, "AP sends no RTS on the NPCA primary channel");
+        NS_TEST_EXPECT_MSG_GT(m_apData, 0, "AP sends data on NPCA");
+        NS_TEST_EXPECT_MSG_EQ(m_apBeaconOnNpca, 0, "no Beacon on the NPCA primary channel");
+
+        // EDCAF state (37.18.4 rule 12)a, 37.18.5)
+        const uint32_t npcaCw = (1U << m_initialQsrc) * (m_cwMin + 1) - 1;
+        NS_TEST_ASSERT_MSG_EQ(m_npcaEnd.empty(), false, "switched back at least once");
+        uint32_t checked = 0;
+        for (std::size_t k = 0; k < m_npcaStart.size() && k < m_npcaEnd.size(); ++k)
+        {
+            const auto completion = m_npcaStart[k] + m_switchingDelay;
+            // CW before the switch
+            uint32_t cwBefore = m_cwMin;
+            for (const auto& [t, cw] : m_cw)
+            {
+                if (t <= m_npcaStart[k])
+                {
+                    cwBefore = cw;
+                }
+            }
+            auto atCompletion = std::find_if(m_cw.cbegin(), m_cw.cend(), [&](const auto& e) {
+                return e.first == completion;
+            });
+            NS_TEST_ASSERT_MSG_EQ((atCompletion != m_cw.cend()), true, "CW set at switch end");
+            NS_TEST_EXPECT_MSG_EQ(atCompletion->second, npcaCw, "CW = 2^QSRC (CWmin + 1) - 1");
+            NS_TEST_EXPECT_MSG_EQ(
+                (std::find(m_backoff.cbegin(), m_backoff.cend(), completion) != m_backoff.cend()),
+                true,
+                "new backoff at switch end");
+            auto atRestore = std::find_if(m_cw.cbegin(), m_cw.cend(), [&](const auto& e) {
+                return e.first == m_npcaEnd[k];
+            });
+            NS_TEST_ASSERT_MSG_EQ((atRestore != m_cw.cend()), true, "CW restored on switch back");
+            NS_TEST_EXPECT_MSG_EQ(atRestore->second, cwBefore, "restored CW");
+            ++checked;
+        }
+        NS_TEST_EXPECT_MSG_GT(checked, 5, "EDCAF state checked over several NPCA operations");
+    }
+    m_apNpca = nullptr;
+    m_staNpca = nullptr;
+    Simulator::Destroy();
+}
+
+/**
+ * @ingroup wifi-test
+ * NPCA test suite.
+ */
+class WifiNpcaTestSuite : public TestSuite
+{
+  public:
+    WifiNpcaTestSuite()
+        : TestSuite("wifi-npca", Type::UNIT)
+    {
+        AddTestCase(new UhrOperationElementTest, TestCase::Duration::QUICK);
+        AddTestCase(new NpcaIcfIcrFrameTest, TestCase::Duration::QUICK);
+        AddTestCase(new EhtNonOfdmaPuncturingTest, TestCase::Duration::QUICK);
+        AddTestCase(new WifiNpcaEndToEndTest(false), TestCase::Duration::QUICK);
+        AddTestCase(new WifiNpcaEndToEndTest(true), TestCase::Duration::QUICK);
+    }
+};
+
+static WifiNpcaTestSuite g_wifiNpcaTestSuite; ///< the test suite
