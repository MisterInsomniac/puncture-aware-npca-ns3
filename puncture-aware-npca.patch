                         m_mac->GetLinkForPhy(emlsrManager->GetMainPhyId()) != m_linkId);
     }
 
+    // NPCA (IEEE P802.11bn D2.0, 37.18.4 rule 8) and 37.7.1): a non-AP STA begins every frame
+    // exchange on the NPCA primary channel with a BSRP NTB Trigger frame as initial Control
+    // frame (RTS frames are not allowed there); the AP answers with a Multi-STA BlockAck frame
+    // in ICR context sent at the rate of the BSRP NTB Trigger frame
+    if (m_mac->GetFrameExchangeManager(m_linkId)->GetNpcaIcfRequired() &&
+        !hdr.GetAddr1().IsGroup() && m_mac->GetTypeOfStation() == STA)
+    {
+        auto protection = std::make_unique<WifiRtsCtsProtection>();
