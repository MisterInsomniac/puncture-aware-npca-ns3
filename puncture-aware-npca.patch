+bool
+WifiPhy::SwitchPrimary20ForNpca(uint8_t p20Index, Time delay)
+{
+    NS_LOG_FUNCTION(this << +p20Index << delay.As(Time::US));
+    if (!IsInitialized() || !m_operatingChannel.IsSet() || IsStateSleep() || IsStateOff())
+    {
+        return false;
+    }
+    if (m_operatingChannel.GetPrimaryChannelIndex(MHz_u{20}) == p20Index)
+    {
+        return false;
+    }
+    if (IsStateTx())
+    {
+        // switch at the end of the current transmission
+        Simulator::Schedule(GetDelayUntilIdle(),
+                            [=, this]() { SwitchPrimary20ForNpca(p20Index, delay); });
+        return true;
+    }
+    auto cfg = m_channelCfg;
+    for (auto& segment : cfg.segments)
+    {
+        segment.p20Index = p20Index;
+    }
+    const auto savedDelay = m_channelSwitchDelay;
+    m_channelSwitchDelay = delay;
+    m_npcaSwitchEnd = Simulator::Now() + delay;
+    m_npcaSwitching = true;
+    SetOperatingChannel(cfg);
+    m_npcaSwitching = false;
+    m_channelSwitchDelay = savedDelay;
+    return true;
+}
+
+bool
+WifiPhy::IsNpcaSwitching() const
+{
+    return m_npcaSwitching;
+}
