@@ -0,0 +1,436 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include "npca-dcf-simulation.h"
+
+#include "ns3/boolean.h"
+#include "ns3/double.h"
+#include "ns3/enum.h"
+#include "ns3/integer.h"
+#include "ns3/log.h"
+#include "ns3/simulator.h"
+#include "ns3/uinteger.h"
+
+#include <algorithm>
+#include <cmath>
+
+namespace ns3
+{
+
+NS_LOG_COMPONENT_DEFINE("NpcaDcfSimulation");
+NS_OBJECT_ENSURE_REGISTERED(NpcaDcfSimulation);
+
+TypeId
+NpcaDcfSimulation::GetTypeId()
+{
+    static TypeId tid =
+        TypeId("ns3::NpcaDcfSimulation")
+            .SetParent<Object>()
+            .SetGroupName("Npca")
+            .AddConstructor<NpcaDcfSimulation>()
+            .AddAttribute("NumStations",
+                          "Number of saturated BSS-A stations.",
+                          UintegerValue(10),
+                          MakeUintegerAccessor(&NpcaDcfSimulation::m_n),
+                          MakeUintegerChecker<uint32_t>(1))
+            .AddAttribute("Slot", "Slot time sigma.", TimeValue(MicroSeconds(9)),
+                          MakeTimeAccessor(&NpcaDcfSimulation::m_slot), MakeTimeChecker())
+            .AddAttribute("Sifs", "SIFS.", TimeValue(MicroSeconds(16)),
+                          MakeTimeAccessor(&NpcaDcfSimulation::m_sifs), MakeTimeChecker())
+            .AddAttribute("Difs", "DIFS.", TimeValue(MicroSeconds(34)),
+                          MakeTimeAccessor(&NpcaDcfSimulation::m_difs), MakeTimeChecker())
+            .AddAttribute("AckDuration", "ACK duration.", TimeValue(MicroSeconds(44)),
+                          MakeTimeAccessor(&NpcaDcfSimulation::m_ack), MakeTimeChecker())
+            .AddAttribute("CwMin", "CWmin (backoff uniform in [0, CW-1]).", UintegerValue(16),
+                          MakeUintegerAccessor(&NpcaDcfSimulation::m_cwMin),
+                          MakeUintegerChecker<uint32_t>(1))
+            .AddAttribute("CwMax", "CWmax.", UintegerValue(1024),
+                          MakeUintegerAccessor(&NpcaDcfSimulation::m_cwMax),
+                          MakeUintegerChecker<uint32_t>(1))
+            .AddAttribute("NpcaSwitchDelay", "T_NPCA: delay after the OBSS PPDU start before "
+                          "NPCA contention may begin.", TimeValue(MicroSeconds(136)),
+                          MakeTimeAccessor(&NpcaDcfSimulation::m_tNpca), MakeTimeChecker())
+            .AddAttribute("SwitchBackDelay", "T_SW: an NPCA exchange must end at least this "
+                          "long before the OBSS PPDU ends.", TimeValue(MicroSeconds(16)),
+                          MakeTimeAccessor(&NpcaDcfSimulation::m_tSw), MakeTimeChecker())
+            .AddAttribute("PayloadAirtime", "Payload airtime at full rate.",
+                          TimeValue(MicroSeconds(300)),
+                          MakeTimeAccessor(&NpcaDcfSimulation::m_payload), MakeTimeChecker())
+            .AddAttribute("Duration", "Simulated time.", TimeValue(Seconds(15)),
+                          MakeTimeAccessor(&NpcaDcfSimulation::m_duration), MakeTimeChecker())
+            .AddAttribute("WeightByUnits",
+                          "Weight throughput by the number of 20 MHz units used (wideband).",
+                          BooleanValue(false),
+                          MakeBooleanAccessor(&NpcaDcfSimulation::m_weightByUnits),
+                          MakeBooleanChecker())
+            .AddAttribute("DifsAfterSwitch",
+                          "Require DIFS of idle medium on the NPCA channel after switching.",
+                          BooleanValue(true),
+                          MakeBooleanAccessor(&NpcaDcfSimulation::m_difsAfterSwitch),
+                          MakeBooleanChecker())
+            .AddAttribute("ObssCorruptsOngoingTx",
+                          "An OBSS PPDU that starts during a BSS-A primary exchange corrupts it.",
+                          BooleanValue(false),
+                          MakeBooleanAccessor(&NpcaDcfSimulation::m_obssCorruptsTx),
+                          MakeBooleanChecker())
+            .AddAttribute("PrimaryPlacement",
+                          "NPCA primary placement.",
+                          EnumValue(NpcaPrimaryPlacement::FIXED),
+                          MakeEnumAccessor<NpcaPrimaryPlacement>(&NpcaDcfSimulation::m_placement),
+                          MakeEnumChecker(NpcaPrimaryPlacement::FIXED, "Fixed",
+                                          NpcaPrimaryPlacement::INFORMED, "Informed",
+                                          NpcaPrimaryPlacement::FLEXIBLE, "Flexible"))
+            .AddAttribute("LearningFraction",
+                          "Fraction of the run used to learn the informed NPCA primary.",
+                          DoubleValue(0.1),
+                          MakeDoubleAccessor(&NpcaDcfSimulation::m_learningFraction),
+                          MakeDoubleChecker<double>(0.0, 1.0))
+            .AddAttribute("InformedFirstUnit",
+                          "First candidate unit for the informed NPCA primary (-1: U/2).",
+                          IntegerValue(-1),
+                          MakeIntegerAccessor(&NpcaDcfSimulation::m_candFirst),
+                          MakeIntegerChecker<int>(-1, 15))
+            .AddAttribute("InformedLastUnit",
+                          "Last candidate unit for the informed NPCA primary (-1: U-1).",
+                          IntegerValue(-1),
+                          MakeIntegerAccessor(&NpcaDcfSimulation::m_candLast),
+                          MakeIntegerChecker<int>(-1, 15))
+            .AddTraceSource("FrameExchange",
+                            "A BSS-A frame exchange ended.",
+                            MakeTraceSourceAccessor(&NpcaDcfSimulation::m_txTrace),
+                            "ns3::NpcaDcfSimulation::TxTracedCallback");
+    return tid;
+}
+
+NpcaDcfSimulation::NpcaDcfSimulation()
+    : m_n(10),
+      m_cwMin(16),
+      m_cwMax(1024),
+      m_weightByUnits(false),
+      m_difsAfterSwitch(true),
+      m_obssCorruptsTx(false),
+      m_placement(NpcaPrimaryPlacement::FIXED),
+      m_learningFraction(0.1),
+      m_candFirst(-1),
+      m_candLast(-1),
+      m_state(ON_PRIMARY),
+      m_counting(false),
+      m_txBusy(false),
+      m_txOnNpca(false),
+      m_txCorrupted(false),
+      m_obssActive(false),
+      m_learning(false),
+      m_payloadUnitTimeUs(0),
+      m_delaySumUs(0)
+{
+    m_selector = CreateObject<NpcaChannelSelector>();
+    m_obss = CreateObject<NpcaObssSource>();
+    m_rng = CreateObject<UniformRandomVariable>();
+}
+
+NpcaDcfSimulation::~NpcaDcfSimulation() = default;
+
+void
+NpcaDcfSimulation::DoDispose()
+{
+    m_selector = nullptr;
+    m_obss = nullptr;
+    m_rng = nullptr;
+    Object::DoDispose();
+}
+
+Ptr<NpcaChannelSelector>
+NpcaDcfSimulation::GetSelector() const
+{
+    return m_selector;
+}
+
+Ptr<NpcaObssSource>
+NpcaDcfSimulation::GetObssSource() const
+{
+    return m_obss;
+}
+
+int64_t
+NpcaDcfSimulation::AssignStreams(int64_t stream)
+{
+    int64_t used = m_obss->AssignStreams(stream);
+    m_rng->SetStream(stream + used);
+    return used + 1;
+}
+
+uint32_t
+NpcaDcfSimulation::DrawBackoff(uint32_t cw)
+{
+    return m_rng->GetInteger(0, cw - 1);
+}
+
+uint32_t
+NpcaDcfSimulation::MinBackoff() const
+{
+    return *std::min_element(m_backoff.begin(), m_backoff.end());
+}
+
+Time
+NpcaDcfSimulation::ExchangeDuration(double eta) const
+{
+    auto payloadNs = static_cast<int64_t>(std::llround(m_payload.GetNanoSeconds() / eta));
+    return NanoSeconds(payloadNs) + m_sifs + m_ack;
+}
+
+NpcaSimResults
+NpcaDcfSimulation::Run()
+{
+    m_res = NpcaSimResults();
+    m_payloadUnitTimeUs = 0;
+    m_delaySumUs = 0;
+    m_backoff.assign(m_n, 0);
+    m_cw.assign(m_n, m_cwMin);
+    m_hol.assign(m_n, Seconds(0));
+    for (auto& b : m_backoff)
+    {
+        b = DrawBackoff(m_cwMin);
+    }
+    m_state = ON_PRIMARY;
+    m_cap = Time::Max();
+    m_obssActive = false;
+    m_txBusy = false;
+    m_observed.clear();
+
+    if (m_placement == NpcaPrimaryPlacement::INFORMED && m_learningFraction > 0)
+    {
+        m_learning = true;
+        Simulator::Schedule(m_duration * m_learningFraction, &NpcaDcfSimulation::EndLearning, this);
+    }
+    ScheduleNextObss();
+    StartCounting(m_difs);
+    Simulator::Stop(m_duration);
+    Simulator::Run();
+
+    const uint8_t u = m_selector->GetBssUnits();
+    const double norm = m_duration.GetMicroSeconds() * (m_weightByUnits ? u : 1.0);
+    m_res.throughput = m_payloadUnitTimeUs / norm;
+    m_res.meanAccessDelayMs = m_res.successes ? m_delaySumUs / m_res.successes / 1000.0 : 0;
+    m_res.npcaPrimary = m_selector->GetNpcaPrimary();
+    return m_res;
+}
+
+void
+NpcaDcfSimulation::ScheduleNextObss()
+{
+    NpcaObssPpdu ppdu = m_obss->Next();
+    if (ppdu.start >= m_duration)
+    {
+        return;
+    }
+    Simulator::Schedule(ppdu.start - Simulator::Now(), &NpcaDcfSimulation::OnObssStart, this, ppdu);
+}
+
+void
+NpcaDcfSimulation::OnObssStart(NpcaObssPpdu ppdu)
+{
+    m_cur = ppdu;
+    m_obssActive = true;
+    ++m_res.obssPpdus;
+    const uint8_t u = m_selector->GetBssUnits();
+    if (m_learning)
+    {
+        m_observed.push_back(ppdu);
+    }
+    if (m_placement == NpcaPrimaryPlacement::FLEXIBLE)
+    {
+        m_sel = m_selector->SelectWithPrimary(ppdu.rx, ppdu.CcaIdle(u), -1);
+    }
+    else
+    {
+        m_sel = m_selector->Select(ppdu.rx, ppdu.CcaIdle(u));
+    }
+    if (m_sel.IsUsable())
+    {
+        ++m_res.npcaEligiblePpdus;
+    }
+    Simulator::Schedule(ppdu.end - Simulator::Now(), &NpcaDcfSimulation::OnObssEnd, this);
+
+    if (m_txBusy)
+    {
+        // a primary-channel exchange is in progress; NPCA is considered when it ends
+        m_txCorrupted = m_txCorrupted || m_obssCorruptsTx;
+        return;
+    }
+    Interrupt(Simulator::Now());
+    EnterNpca(Simulator::Now());
+}
+
+void
+NpcaDcfSimulation::EnterNpca(Time freeAt)
+{
+    if (!m_sel.IsUsable())
+    {
+        m_state = FROZEN; // wait for the primary channel
+        return;
+    }
+    m_state = ON_NPCA;
+    m_cap = m_cur.end - m_tSw - ExchangeDuration(m_sel.eta);
+    Time t0 = std::max(m_cur.start + m_tNpca, freeAt) + (m_difsAfterSwitch ? m_difs : Time(0));
+    StartCounting(t0);
+}
+
+void
+NpcaDcfSimulation::StartCounting(Time t0)
+{
+    m_counting = true;
+    m_countStart = t0;
+    Time ttx = t0 + m_slot * MinBackoff();
+    if (m_state == ON_NPCA && ttx > m_cap)
+    {
+        return; // the exchange would not fit before the NPCA timer expires: counters freeze
+    }
+    m_txEvent = Simulator::Schedule(ttx - Simulator::Now(), &NpcaDcfSimulation::TxStart, this);
+}
+
+void
+NpcaDcfSimulation::Interrupt(Time t)
+{
+    if (!m_counting)
+    {
+        return;
+    }
+    m_counting = false;
+    m_txEvent.Cancel();
+    Time limit = (m_state == ON_NPCA) ? std::min(t, m_cap) : t;
+    if (limit <= m_countStart)
+    {
+        return;
+    }
+    auto k = static_cast<uint32_t>((limit - m_countStart).GetNanoSeconds() / m_slot.GetNanoSeconds());
+    uint32_t minb = MinBackoff();
+    k = std::min(k, minb > 0 ? minb - 1 : 0);
+    for (auto& b : m_backoff)
+    {
+        b -= k;
+    }
+}
+
+void
+NpcaDcfSimulation::TxStart()
+{
+    m_counting = false;
+    uint32_t minb = MinBackoff();
+    std::vector<uint32_t> winners;
+    for (uint32_t i = 0; i < m_n; ++i)
+    {
+        m_backoff[i] -= minb;
+        if (m_backoff[i] == 0)
+        {
+            winners.push_back(i);
+        }
+    }
+    m_txBusy = true;
+    m_txCorrupted = false;
+    m_txOnNpca = (m_state == ON_NPCA);
+    UnitSet channel = m_txOnNpca ? m_sel.channel
+                                 : NpcaChannelSets::Range(0, m_selector->GetBssUnits());
+    double eta = m_txOnNpca ? m_sel.eta : 1.0;
+    Simulator::Schedule(ExchangeDuration(eta), &NpcaDcfSimulation::TxEnd, this, winners, channel);
+}
+
+void
+NpcaDcfSimulation::TxEnd(std::vector<uint32_t> winners, UnitSet channel)
+{
+    m_txBusy = false;
+    bool success = winners.size() == 1 && !m_txCorrupted;
+    Time now = Simulator::Now();
+    if (success)
+    {
+        uint32_t i = winners[0];
+        double weight = m_weightByUnits ? NpcaChannelSets::Count(channel) : 1.0;
+        m_payloadUnitTimeUs += m_payload.GetMicroSeconds() * weight;
+        m_delaySumUs += (now - m_hol[i]).GetMicroSeconds();
+        ++m_res.successes;
+        if (m_txOnNpca)
+        {
+            ++m_res.npcaSuccesses;
+        }
+        m_hol[i] = now;
+        m_cw[i] = m_cwMin;
+        m_backoff[i] = DrawBackoff(m_cwMin);
+    }
+    else
+    {
+        ++m_res.collisions;
+        for (uint32_t i : winners)
+        {
+            m_cw[i] = std::min(2 * m_cw[i], m_cwMax);
+            m_backoff[i] = DrawBackoff(m_cw[i]);
+        }
+    }
+    m_txTrace(now, channel, success);
+
+    if (m_obssActive)
+    {
+        if (m_txOnNpca)
+        {
+            StartCounting(now + m_difs); // continue on the NPCA channel
+        }
+        else
+        {
+            EnterNpca(now);
+        }
+    }
+    else
+    {
+        m_state = ON_PRIMARY;
+        m_cap = Time::Max();
+        StartCounting(now + m_difs);
+    }
+}
+
+void
+NpcaDcfSimulation::OnObssEnd()
+{
+    m_obssActive = false;
+    if (!m_txBusy)
+    {
+        Interrupt(Simulator::Now());
+        m_state = ON_PRIMARY;
+        m_cap = Time::Max();
+        StartCounting(Simulator::Now() + m_difs);
+    }
+    ScheduleNextObss();
+}
+
+void
+NpcaDcfSimulation::EndLearning()
+{
+    m_learning = false;
+    const uint8_t u = m_selector->GetBssUnits();
+    int first = m_candFirst >= 0 ? m_candFirst : u / 2;
+    int last = m_candLast >= 0 ? m_candLast : u - 1;
+    int best = m_selector->GetNpcaPrimary();
+    auto score = [this, u](int unp) {
+        double s = 0;
+        for (const auto& p : m_observed)
+        {
+            s += m_selector->SelectWithPrimary(p.rx, p.CcaIdle(u), unp).units;
+        }
+        return s;
+    };
+    double bestScore = score(best); // the default channel is kept on ties
+    for (int c = first; c <= last; ++c)
+    {
+        double s = score(c);
+        if (s > bestScore + 1e-9)
+        {
+            best = c;
+            bestScore = s;
+        }
+    }
+    NS_LOG_INFO("Informed NPCA primary: unit " << best << " (" << m_observed.size()
+                                               << " PPDUs observed)");
+    m_selector->SetNpcaPrimary(best);
+}
+
+} // namespace ns3
