@@ -89,7 +89,12 @@ WifiDefaultProtectionManager::TryAddMpdu(Ptr<const WifiMpdu> mpdu, const WifiTxP
     auto dlMuPpdu = txParams.m_txVector.IsDlMu() && psduInfoMap.size() > 1;
     auto isEmlsrDestination = GetWifiRemoteStationManager()->GetEmlsrEnabled(hdr.GetAddr1());
 
-    if (dlMuPpdu || isEmlsrDestination ||
+    // NPCA (IEEE P802.11bn D2.0, 37.18.4 rule 8)a): an AP begins every frame exchange on the
+    // NPCA primary channel with an MU-RTS Trigger frame as initial Control frame
+    auto npcaApIcf = m_mac->GetTypeOfStation() == AP && !hdr.GetAddr1().IsGroup() &&
+                     m_mac->GetFrameExchangeManager(m_linkId)->GetNpcaIcfRequired();
+
+    if (dlMuPpdu || isEmlsrDestination || npcaApIcf ||
