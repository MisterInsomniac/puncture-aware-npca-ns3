diff --git a/src/npca/examples/npca-paper-scenarios.cc b/src/npca/examples/npca-paper-scenarios.cc
new file mode 100644
index 0000000..2ac6ed2
--- /dev/null
+++ b/src/npca/examples/npca-paper-scenarios.cc
@@ -0,0 +1,396 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Reproduces the evaluation of "Puncture-Aware Non-Primary Channel Access: Exploiting
+ * Preamble Puncturing for In-Band Spectrum Reuse in Wide-Bandwidth WLANs".
+ *
+ * Scenarios (Table I):
+ *   --scenario=base      80 MHz BSS, NPCA channel ch2, OBSS 20/40/80 MHz (Sec. V-A)
+ *   --scenario=wideband  320 MHz BSS (U=16), unp = 8, OBSS 80/160/320 MHz (Sec. V-B..E)
+ *
+ * One parameter can be swept with --sweep=name:v1,v2,...  where name is one of
+ *   ppunc | pi | q | rho | n | obssWidth (MHz) | numAps | rssi (none,-72,-62,-52)
+ *
+ * Output: CSV on stdout, one row per (sweep value, scheme, run). With --model=1 the
+ * analytical model (Eq. 4 / Eq. 5) is printed instead, with run = -1.
+ *
+ * Examples:
+ *   ./ns3 run "npca-paper-scenarios --scenario=base --sweep=ppunc:0,0.2,0.4,0.6,0.8 --q=1"
+ *   ./ns3 run "npca-paper-scenarios --scenario=wideband --sweep=obssWidth:80,160,320"
+ */
+
+#include "ns3/core-module.h"
+#include "ns3/npca-module.h"
+
+#include <cmath>
+#include <iomanip>
+#include <iostream>
+#include <sstream>
+
+using namespace ns3;
+
+NS_LOG_COMPONENT_DEFINE("NpcaPaperScenarios");
+
+namespace
+{
+
+/// All configurable knobs of one evaluation point
+struct ScenarioConfig
+{
+    std::string scenario{"base"};
+    uint8_t bssUnits{4};
+    int unp{2};
+    double rho{0.5};
+    double pi{0.4};
+    double q{1.0};
+    int targetedUnit{2};
+    std::string widths{"1:0.15,2:0.25,4:0.6"};
+    uint32_t numAps{0};
+    double perApLoad{0.2};
+    uint32_t n{10};
+    double payloadUs{300};
+    bool weighted{false};
+    double eta1{1.0};
+    double eta2{1.0};
+    bool leakageAware{false};
+    double durationS{15};
+    bool corrupt{false};
+    bool difsAfterSwitch{true};
+};
+
+std::vector<std::string>
+Split(const std::string& s, char sep)
+{
+    std::vector<std::string> out;
+    std::istringstream iss(s);
+    std::string item;
+    while (std::getline(iss, item, sep))
+    {
+        if (!item.empty())
+        {
+            out.push_back(item);
+        }
+    }
+    return out;
+}
+
+/// Apply one sweep value to the configuration
+void
+Apply(ScenarioConfig& c, const std::string& name, const std::string& value)
+{
+    if (name == "ppunc" || name == "pi")
+    {
+        c.pi = std::stod(value);
+    }
+    else if (name == "q")
+    {
+        c.q = std::stod(value);
+    }
+    else if (name == "rho")
+    {
+        c.rho = std::stod(value);
+    }
+    else if (name == "n")
+    {
+        c.n = std::stoul(value);
+    }
+    else if (name == "obssWidth")
+    {
+        c.widths = std::to_string(std::stoi(value) / 20) + ":1";
+    }
+    else if (name == "numAps")
+    {
+        c.numAps = std::stoul(value);
+    }
+    else if (name == "rssi")
+    {
+        // Table II: rate fraction with one / two active neighbours
+        if (value == "none")
+        {
+            c.eta1 = 1.0, c.eta2 = 1.0;
+        }
+        else if (value == "-72")
+        {
+            c.eta1 = 0.89, c.eta2 = 0.80;
+        }
+        else if (value == "-62")
+        {
+            c.eta1 = 0.67, c.eta2 = 0.60;
+        }
+        else if (value == "-52")
+        {
+            c.eta1 = 0.27, c.eta2 = 0.20;
+        }
+        else
+        {
+            NS_ABORT_MSG("rssi must be none, -72, -62 or -52");
+        }
+    }
+    else
+    {
+        NS_ABORT_MSG("Unknown sweep parameter " << name);
+    }
+}
+
+/// Configure and run one simulation
+NpcaSimResults
+RunSim(const ScenarioConfig& c, const std::string& scheme, uint32_t run)
+{
+    RngSeedManager::SetSeed(1);
+    RngSeedManager::SetRun(run);
+
+    auto sim = CreateObject<NpcaDcfSimulation>();
+    sim->SetAttribute("NumStations", UintegerValue(c.n));
+    sim->SetAttribute("PayloadAirtime", TimeValue(MicroSeconds(c.payloadUs)));
+    sim->SetAttribute("WeightByUnits", BooleanValue(c.weighted));
+    sim->SetAttribute("Duration", TimeValue(Seconds(c.durationS)));
+    sim->SetAttribute("ObssCorruptsOngoingTx", BooleanValue(c.corrupt));
+    sim->SetAttribute("DifsAfterSwitch", BooleanValue(c.difsAfterSwitch));
+
+    auto sel = sim->GetSelector();
+    sel->SetAttribute("BssUnits", UintegerValue(c.bssUnits));
+    sel->SetAttribute("NpcaPrimary", IntegerValue(c.unp));
+    sel->SetAttribute("Eta1", DoubleValue(c.eta1));
+    sel->SetAttribute("Eta2", DoubleValue(c.eta2));
+    sel->SetAttribute("LeakageAware", BooleanValue(c.leakageAware));
+
+    auto obss = sim->GetObssSource();
+    obss->SetAttribute("DutyCycle", DoubleValue(c.rho));
+    obss->SetAttribute("WidthDistribution", StringValue(c.widths));
+    obss->SetAttribute("PuncturingProbability", DoubleValue(c.pi));
+    obss->SetAttribute("IdleProbability", DoubleValue(c.q));
+    obss->SetAttribute("TargetedUnit", IntegerValue(c.targetedUnit));
+    obss->SetAttribute("NumAps", UintegerValue(c.numAps));
+    obss->SetAttribute("PerApLoad", DoubleValue(c.perApLoad));
+
+    if (scheme == "legacy")
+    {
+        sel->SetScheme(NpcaScheme::LEGACY);
+    }
+    else if (scheme == "standard")
+    {
+        sel->SetScheme(NpcaScheme::STANDARD);
+    }
+    else if (scheme == "pa")
+    {
+        sel->SetScheme(NpcaScheme::PUNCTURE_AWARE);
+    }
+    else if (scheme == "pa-informed")
+    {
+        sel->SetScheme(NpcaScheme::PUNCTURE_AWARE);
+        sim->SetAttribute("PrimaryPlacement", EnumValue(NpcaPrimaryPlacement::INFORMED));
+    }
+    else if (scheme == "pa-flexible")
+    {
+        sel->SetScheme(NpcaScheme::PUNCTURE_AWARE);
+        sim->SetAttribute("PrimaryPlacement", EnumValue(NpcaPrimaryPlacement::FLEXIBLE));
+    }
+    else if (scheme == "pa-unconstrained")
+    {
+        sel->SetScheme(NpcaScheme::PUNCTURE_AWARE);
+        sel->SetAttribute("Unconstrained", BooleanValue(true));
+    }
+    else
+    {
+        NS_ABORT_MSG("Unknown scheme " << scheme);
+    }
+
+    sim->AssignStreams(0); // same OBSS timeline for every scheme (common random numbers)
+    NpcaSimResults r = sim->Run();
+    sim->Dispose();
+    Simulator::Destroy();
+    return r;
+}
+
+/// Evaluate the analytical model for a scheme
+double
+RunModel(const ScenarioConfig& c, const std::string& scheme)
+{
+    NpcaAnalyticalModel::Params p;
+    p.bssUnits = c.bssUnits;
+    p.npcaPrimary = c.unp;
+    p.rho = c.numAps > 0 ? 1.0 - std::pow(1.0 - c.perApLoad, c.numAps) : c.rho;
+    p.pi = c.pi;
+    p.q = c.q;
+    p.targetedUnit = c.targetedUnit;
+    p.weighted = c.weighted;
+    p.widthDist.clear();
+    for (const auto& item : Split(c.widths, ','))
+    {
+        auto pos = item.find(':');
+        p.widthDist.emplace_back(std::stoi(item.substr(0, pos)), std::stod(item.substr(pos + 1)));
+    }
+    const double full = c.weighted ? c.bssUnits : 1.0;
+    double value = 0;
+    if (scheme == "legacy")
+    {
+        value = (1.0 - p.rho) * full;
+    }
+    else if (scheme == "standard")
+    {
+        value = NpcaAnalyticalModel::ExpectedUnits(p, NpcaAnalyticalModel::STANDARD);
+    }
+    else if (scheme == "pa")
+    {
+        value = NpcaAnalyticalModel::ExpectedUnits(p, NpcaAnalyticalModel::PUNCTURE_AWARE);
+    }
+    else if (scheme == "pa-informed")
+    {
+        // model counterpart: the best unp within the D2.0 range, default kept on ties
+        value = NpcaAnalyticalModel::ExpectedUnits(p, NpcaAnalyticalModel::PUNCTURE_AWARE);
+        for (int u = c.bssUnits / 2; u < c.bssUnits; ++u)
+        {
+            auto pp = p;
+            pp.npcaPrimary = u;
+            value = std::max(value,
+                             NpcaAnalyticalModel::ExpectedUnits(pp,
+                                                                NpcaAnalyticalModel::PUNCTURE_AWARE));
+        }
+    }
+    else if (scheme == "pa-flexible")
+    {
+        value = NpcaAnalyticalModel::ExpectedUnits(p, NpcaAnalyticalModel::FLEXIBLE);
+    }
+    else if (scheme == "pa-unconstrained")
+    {
+        value = NpcaAnalyticalModel::ExpectedUnits(p, NpcaAnalyticalModel::UNCONSTRAINED);
+    }
+    return value / full; // normalized usable bandwidth (upper bound on throughput shape)
+}
+
+} // namespace
+
+int
+main(int argc, char* argv[])
+{
+    ScenarioConfig c;
+    std::string scenario = "base";
+    std::string schemes;
+    std::string sweep;
+    uint32_t runs = 10;
+    uint32_t firstRun = 1;
+    bool model = false;
+    bool header = true;
+    // overrides (negative / empty = keep scenario default)
+    double rho = -1, pi = -1, q = -1, duration = -1, eta1 = -1, eta2 = -1;
+    int n = -1, unp = -100, numAps = -1;
+    std::string widths;
+    bool leakageAware = false;
+    bool corrupt = false;
+    bool difsAfterSwitch = true;
+
+    CommandLine cmd(__FILE__);
+    cmd.AddValue("scenario", "base or wideband", scenario);
+    cmd.AddValue("schemes",
+                 "Comma-separated: legacy,standard,pa,pa-informed,pa-flexible,pa-unconstrained",
+                 schemes);
+    cmd.AddValue("sweep", "name:v1,v2,... (ppunc|pi|q|rho|n|obssWidth|numAps|rssi)", sweep);
+    cmd.AddValue("runs", "Number of seeds (RngRun values)", runs);
+    cmd.AddValue("firstRun", "First RngRun value", firstRun);
+    cmd.AddValue("duration", "Simulated seconds per run", duration);
+    cmd.AddValue("model", "Print the analytical model instead of simulating", model);
+    cmd.AddValue("header", "Print the CSV header", header);
+    cmd.AddValue("rho", "OBSS duty cycle", rho);
+    cmd.AddValue("ppunc", "Puncturing probability (ppunc in base, pi in wideband)", pi);
+    cmd.AddValue("pi", "Same as --ppunc", pi);
+    cmd.AddValue("q", "Probability that a punctured block is idle", q);
+    cmd.AddValue("n", "Number of BSS-A stations", n);
+    cmd.AddValue("unp", "NPCA primary unit", unp);
+    cmd.AddValue("obssWidths", "OBSS width distribution 'units:p,...'", widths);
+    cmd.AddValue("numAps", "Number of CSMA-coupled OBSS APs (wideband Fig. 4c)", numAps);
+    cmd.AddValue("eta1", "Rate fraction with one active neighbour", eta1);
+    cmd.AddValue("eta2", "Rate fraction with two active neighbours", eta2);
+    cmd.AddValue("leakageAware", "Use the |S|eta(S) selection", leakageAware);
+    cmd.AddValue("corruptOngoing", "OBSS start corrupts an ongoing BSS-A exchange", corrupt);
+    cmd.AddValue("difsAfterSwitch", "DIFS on the NPCA channel after switching", difsAfterSwitch);
+    cmd.Parse(argc, argv);
+
+    if (scenario == "base")
+    {
+        c.scenario = "base";
+        if (schemes.empty())
+        {
+            schemes = "legacy,standard,pa";
+        }
+    }
+    else if (scenario == "wideband")
+    {
+        c.scenario = "wideband";
+        c.bssUnits = 16;
+        c.unp = 8;
+        c.rho = 0.4;
+        c.pi = 0.3;
+        c.q = 0.8;
+        c.targetedUnit = -1;
+        c.widths = "16:1";
+        c.payloadUs = 75;
+        c.weighted = true;
+        if (schemes.empty())
+        {
+            schemes = "legacy,standard,pa,pa-informed,pa-flexible";
+        }
+    }
+    else
+    {
+        NS_ABORT_MSG("scenario must be base or wideband");
+    }
+    if (rho >= 0) c.rho = rho;
+    if (pi >= 0) c.pi = pi;
+    if (q >= 0) c.q = q;
+    if (n > 0) c.n = n;
+    if (unp > -100) c.unp = unp;
+    if (!widths.empty()) c.widths = widths;
+    if (numAps >= 0) c.numAps = numAps;
+    if (duration > 0) c.durationS = duration;
+    if (eta1 >= 0) c.eta1 = eta1;
+    if (eta2 >= 0) c.eta2 = eta2;
+    c.leakageAware = leakageAware;
+    c.corrupt = corrupt;
+    c.difsAfterSwitch = difsAfterSwitch;
+
+    std::string sweepName = "none";
+    std::vector<std::string> sweepValues{"-"};
+    if (!sweep.empty())
+    {
+        auto pos = sweep.find(':');
+        NS_ABORT_MSG_IF(pos == std::string::npos, "--sweep must be name:v1,v2,...");
+        sweepName = sweep.substr(0, pos);
+        sweepValues = Split(sweep.substr(pos + 1), ',');
+    }
+
+    if (header)
+    {
+        std::cout << "scenario,sweep,value,scheme,run,throughput,delay_ms,successes,collisions,"
+                     "npca_successes,obss_ppdus,npca_eligible,unp\n";
+    }
+    std::cout << std::setprecision(8);
+    for (const auto& v : sweepValues)
+    {
+        ScenarioConfig cv = c;
+        if (sweepName != "none")
+        {
+            Apply(cv, sweepName, v);
+        }
+        for (const auto& scheme : Split(schemes, ','))
+        {
+            if (model)
+            {
+                std::cout << cv.scenario << "," << sweepName << "," << v << "," << scheme
+                          << ",-1," << RunModel(cv, scheme) << ",,,,,,,\n";
+                continue;
+            }
+            for (uint32_t r = firstRun; r < firstRun + runs; ++r)
+            {
+                NpcaSimResults res = RunSim(cv, scheme, r);
+                std::cout << cv.scenario << "," << sweepName << "," << v << "," << scheme << ","
+                          << r << "," << res.throughput << "," << res.meanAccessDelayMs << ","
+                          << res.successes << "," << res.collisions << "," << res.npcaSuccesses
+                          << "," << res.obssPpdus << "," << res.npcaEligiblePpdus << ","
+                          << res.npcaPrimary << "\n";
+            }
+        }
+    }
+    return 0;
+}
diff --git a/src/npca/examples/npca-wifi-mac.cc b/src/npca/examples/npca-wifi-mac.cc
new file mode 100644
index 0000000..e4a8620
--- /dev/null
+++ b/src/npca/examples/npca-wifi-mac.cc
@@ -0,0 +1,457 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Full-stack ns-3 Wi-Fi evaluation of NPCA (IEEE P802.11bn) and puncture-aware NPCA.
+ *
+ * Two 802.11be BSSs operate on the same 80 MHz channel 42 (5 GHz) with the same primary
+ * 20 MHz channel (channel 36, index 0):
+ *  - OBSS (BSS color 2): an AP sends bursts of downlink traffic to its STA. Its data PPDUs are
+ *    80 MHz EHT PPDUs; with probability ppunc they are preamble-punctured on the 20 MHz
+ *    channel with index 2 (channel 44), e.g. because the OBSS AP statically disables it.
+ *  - BSS-A (BSS color 1): nSta stations send saturated uplink traffic to their AP. With NPCA,
+ *    the AP advertises NPCA primary channel index 2 (channel 44) in the UHR Operation element.
+ *
+ * Every node runs the real ns-3 MAC/PHY (SpectrumWifiPhy, EDCA, A-MPDU, Block Ack). When a
+ * BSS-A device decodes the U-SIG of an OBSS PPDU, its NpcaManager applies PHYLEN NPCA
+ * (IEEE P802.11bn D2.0, 37.18):
+ *  - standard NPCA: channel 44 lies in CH_BANDWIDTH of an 80 MHz OBSS PPDU, so NPCA is
+ *    never possible in this scenario;
+ *  - puncture-aware NPCA: channel 44 is usable when it is in INACTIVE_SUBCHANNELS.
+ * The device switches its primary 20 MHz to channel 44 (NPCA switching delay), the EDCAFs
+ * start a new backoff with the Initial NPCA QSRC, non-AP STAs start every TXOP with a BSRP
+ * NTB Trigger frame answered by a Multi-STA BlockAck in ICR context, the AP with an MU-RTS
+ * Trigger frame, and everything ends when NPCA_TIMER expires (one switching back delay before
+ * the OBSS PPDU ends); then the stored EDCAF state is restored.
+ *
+ * The OBSS AP uses high-priority EDCA (obssCw, obssAifsn) so that its occupancy of the
+ * primary channel hardly depends on BSS-A, as in the paper's evaluation. With the default
+ * distance (15 m) the OBSS RSSI at BSS-A is about -66 dBm; at shorter distances the
+ * adjacent-channel leakage of the OBSS PPDU makes the per-20 MHz CCA of the NPCA channel
+ * busy and the AP does not answer the ICF (UL MU CS), as the standard requires.
+ *
+ * Set the environment variable NPCA_DEBUG to print per-frame-type counters.
+ *
+ *   ./ns3 run "npca-wifi-mac --scheme=pa --ppunc=0.8"
+ */
+
+#include "ns3/core-module.h"
+#include "ns3/mobility-module.h"
+#include "ns3/network-module.h"
+#include "ns3/propagation-module.h"
+#include "ns3/spectrum-module.h"
+#include "ns3/wifi-module.h"
+
+#include <iomanip>
+#include <iostream>
+
+using namespace ns3;
+
+NS_LOG_COMPONENT_DEFINE("NpcaWifiMac");
+
+namespace
+{
+
+uint64_t g_bssARxBytes = 0;     //!< bytes received by the BSS-A AP after warm-up
+uint64_t g_bssARxNpcaBytes = 0; //!< ... while operating on the NPCA channel
+uint64_t g_obssRxBytes = 0;     //!< bytes received by the OBSS STA after warm-up
+uint64_t g_npcaStarts = 0;      //!< NPCA operations started at the BSS-A AP
+uint64_t g_obssPpdus = 0;       //!< OBSS data PPDUs transmitted
+uint64_t g_obssPunctured = 0;   //!< ... of which punctured
+Time g_warmup;                  //!< start of the measurement
+Ptr<NpcaManager> g_apNpca;      //!< NPCA manager of the BSS-A AP
+std::map<std::string, uint64_t> g_debug; //!< debug counters
+Ptr<NpcaManager> g_sta0Npca;             //!< NPCA manager of STA 0 (debug)
+
+void
+ObssStaRxError(Ptr<const Packet>, double snr)
+{
+    g_debug["obssSta RxError"]++;
+}
+
+void
+ObssStaRxOk(Ptr<const Packet>, double snr, WifiMode, WifiPreamble)
+{
+    g_debug["obssSta RxOk"]++;
+}
+
+
+void
+Sta0Tx(WifiConstPsduMap psdus, WifiTxVector txVector, double)
+{
+    const bool npca = g_sta0Npca && g_sta0Npca->IsActive();
+    const auto& hdr = psdus.begin()->second->GetHeader(0);
+    std::ostringstream oss;
+    oss << "sta0 tx " << (npca ? "NPCA " : "primary ")
+        << (hdr.IsRts() ? "RTS" : (hdr.IsQosData() ? "DATA" : hdr.GetTypeString())) << " "
+        << txVector.GetChannelWidth() << "MHz";
+    g_debug[oss.str()]++;
+}
+
+void
+ApSniff(Ptr<const Packet> p, uint16_t, WifiTxVector txv, MpduInfo, SignalNoiseDbm, uint16_t)
+{
+    WifiMacHeader hdr;
+    p->PeekHeader(hdr);
+    if (hdr.IsTrigger())
+    {
+        auto copy = p->Copy();
+        copy->RemoveHeader(hdr);
+        WifiMacTrailer fcs;
+        copy->RemoveTrailer(fcs);
+        CtrlTriggerHeader trigger;
+        copy->PeekHeader(trigger);
+        g_debug[std::string("ap rx trigger ntb=") + (trigger.IsBsrpNtb() ? "1" : "0") +
+                " npcaInd=" + (trigger.GetNpcaPrimaryChannelIndication() ? "1" : "0")]++;
+    }
+}
+
+void
+StaSniff(Ptr<const Packet> p, uint16_t, WifiTxVector txv, MpduInfo, SignalNoiseDbm, uint16_t)
+{
+    WifiMacHeader hdr;
+    p->PeekHeader(hdr);
+    if (hdr.IsBlockAck())
+    {
+        std::ostringstream oss;
+        oss << "sta0 rx BACKRESP " << txv.GetChannelWidth() << "MHz " << txv.GetMode()
+            << (g_sta0Npca && g_sta0Npca->IsActive() ? " NPCA" : " primary");
+        g_debug[oss.str()]++;
+    }
+}
+
+void
+StaRxDrop(Ptr<const Packet>, WifiPhyRxfailureReason reason)
+{
+    if (g_sta0Npca && g_sta0Npca->IsActive())
+    {
+        std::ostringstream oss;
+        oss << "sta0 NPCA drop " << reason;
+        g_debug[oss.str()]++;
+    }
+}
+
+void
+ApTx(WifiConstPsduMap psdus, WifiTxVector txVector, double)
+{
+    const auto& hdr = psdus.begin()->second->GetHeader(0);
+    if (hdr.IsBlockAck() || hdr.IsCts() || hdr.IsTrigger())
+    {
+        g_debug[std::string("ap tx ") + hdr.GetTypeString()]++;
+    }
+}
+
+void
+ObssStaRxDrop(Ptr<const Packet>, WifiPhyRxfailureReason reason)
+{
+    std::ostringstream oss;
+    oss << "obssSta drop " << reason;
+    g_debug[oss.str()]++;
+}
+
+void
+BssARx(Ptr<const Packet> p)
+{
+    if (Simulator::Now() < g_warmup)
+    {
+        return;
+    }
+    g_bssARxBytes += p->GetSize();
+    if (g_apNpca && g_apNpca->IsActive())
+    {
+        g_bssARxNpcaBytes += p->GetSize();
+    }
+}
+
+void
+ObssRx(Ptr<const Packet> p)
+{
+    if (Simulator::Now() >= g_warmup)
+    {
+        g_obssRxBytes += p->GetSize();
+    }
+}
+
+void
+ObssPhyTx(WifiConstPsduMap psdus, WifiTxVector txVector, double /* txPowerW */)
+{
+    if (txVector.GetPreambleType() == WIFI_PREAMBLE_EHT_MU)
+    {
+        ++g_obssPpdus;
+        const auto& inactive = txVector.GetInactiveSubchannels();
+        if (std::find(inactive.begin(), inactive.end(), true) != inactive.end())
+        {
+            ++g_obssPunctured;
+        }
+    }
+}
+
+void
+NpcaStart(Time, uint8_t, MHz_u)
+{
+    ++g_npcaStarts;
+}
+
+/// keep the queue of a saturated source non-empty
+void
+Refill(Ptr<NetDevice> dev, Address dst, uint32_t pkts, Time period)
+{
+    for (uint32_t i = 0; i < pkts; ++i)
+    {
+        dev->Send(Create<Packet>(1400), dst, 0x0800);
+    }
+    Simulator::Schedule(period, &Refill, dev, dst, pkts, period);
+}
+
+/// OBSS bursts: exponential gaps, each burst fills about one long A-MPDU
+void
+ObssBurst(Ptr<NetDevice> dev, Address dst, uint32_t pkts, Ptr<ExponentialRandomVariable> gap)
+{
+    for (uint32_t i = 0; i < pkts; ++i)
+    {
+        dev->Send(Create<Packet>(1400), dst, 0x0800);
+    }
+    Simulator::Schedule(MicroSeconds(gap->GetValue()), &ObssBurst, dev, dst, pkts, gap);
+}
+
+} // namespace
+
+int
+main(int argc, char* argv[])
+{
+    std::string scheme = "pa";
+    double ppunc = 0.8;
+    uint32_t nSta = 4;
+    double simTime = 3.0;
+    double warmup = 0.5;
+    double obssGapUs = 7400;
+    uint32_t obssBurst = 48;
+    uint32_t obssCw = 2;
+    uint32_t obssAifsn = 2;
+    double distance = 15;
+    uint32_t run = 1;
+    bool header = true;
+    std::string obssMcs = "EhtMcs3";
+    std::string bssMcs = "EhtMcs5";
+
+    CommandLine cmd(__FILE__);
+    cmd.AddValue("scheme", "legacy | standard | pa", scheme);
+    cmd.AddValue("ppunc", "Probability that an OBSS data PPDU punctures channel 44", ppunc);
+    cmd.AddValue("nSta", "Number of BSS-A stations", nSta);
+    cmd.AddValue("simTime", "Simulated seconds", simTime);
+    cmd.AddValue("warmup", "Seconds before measuring", warmup);
+    cmd.AddValue("obssGapUs", "Mean gap between OBSS bursts (us)", obssGapUs);
+    cmd.AddValue("obssBurst", "Packets per OBSS burst", obssBurst);
+    cmd.AddValue("obssMcs", "OBSS data mode", obssMcs);
+    cmd.AddValue("bssMcs", "BSS-A data mode", bssMcs);
+    cmd.AddValue("obssCw",
+                 "CWmin = CWmax of the OBSS AP (small values let the OBSS seize the primary "
+                 "channel whenever it has traffic, approximating the exogenous OBSS of the paper)",
+                 obssCw);
+    cmd.AddValue("obssAifsn", "AIFSN of the OBSS AP", obssAifsn);
+    cmd.AddValue("distance",
+                 "Distance (m) between the OBSS AP and the BSS-A AP (15 m: OBSS RSSI at BSS-A "
+                 "about -66 dBm)",
+                 distance);
+    cmd.AddValue("run", "RngRun", run);
+    cmd.AddValue("header", "Print CSV header", header);
+    cmd.Parse(argc, argv);
+
+    RngSeedManager::SetSeed(1);
+    RngSeedManager::SetRun(run);
+    g_warmup = Seconds(warmup);
+
+    NodeContainer obssAp(1);
+    NodeContainer obssSta(1);
+    NodeContainer apA(1);
+    NodeContainer staA(nSta);
+
+    auto spectrumChannel = CreateObject<MultiModelSpectrumChannel>();
+    auto loss = CreateObject<LogDistancePropagationLossModel>();
+    loss->SetAttribute("Exponent", DoubleValue(3.0));
+    loss->SetAttribute("ReferenceLoss", DoubleValue(46.7));
+    spectrumChannel->AddPropagationLossModel(loss);
+    spectrumChannel->SetPropagationDelayModel(CreateObject<ConstantSpeedPropagationDelayModel>());
+
+    SpectrumWifiPhyHelper phy;
+    phy.SetChannel(spectrumChannel);
+    phy.Set("ChannelSettings", StringValue("{42, 80, BAND_5GHZ, 0}"));
+
+    // longer A-MPDUs so that OBSS PPDUs last a few ms, as in the paper
+    Config::SetDefault("ns3::WifiMac::BE_MaxAmpduSize", UintegerValue(6500631));
+
+    WifiHelper obssWifi;
+    obssWifi.SetStandard(WIFI_STANDARD_80211be);
+    obssWifi.SetRemoteStationManager("ns3::ConstantRateWifiManager",
+                                     "DataMode",
+                                     StringValue(obssMcs),
+                                     "ControlMode",
+                                     StringValue("OfdmRate24Mbps"));
+    WifiHelper wifiA;
+    wifiA.SetStandard(WIFI_STANDARD_80211be);
+    wifiA.SetRemoteStationManager("ns3::ConstantRateWifiManager",
+                                  "DataMode",
+                                  StringValue(bssMcs),
+                                  "ControlMode",
+                                  StringValue("OfdmRate24Mbps"));
+
+    // all nodes are in one collision domain and decode each other's preambles
+    const double obssPower = 16.0;
+    const double bssPower = 16.0;
+    WifiMacHelper mac;
+    phy.Set("TxPowerStart", DoubleValue(obssPower));
+    phy.Set("TxPowerEnd", DoubleValue(obssPower));
+    mac.SetType("ns3::ApWifiMac", "Ssid", SsidValue(Ssid("obss")));
+    auto obssApDev = obssWifi.Install(phy, mac, obssAp);
+    mac.SetType("ns3::StaWifiMac", "Ssid", SsidValue(Ssid("obss")));
+    auto obssStaDev = obssWifi.Install(phy, mac, obssSta);
+    phy.Set("TxPowerStart", DoubleValue(bssPower));
+    phy.Set("TxPowerEnd", DoubleValue(bssPower));
+    mac.SetType("ns3::ApWifiMac", "Ssid", SsidValue(Ssid("bss-a")));
+    auto apADev = wifiA.Install(phy, mac, apA);
+    mac.SetType("ns3::StaWifiMac", "Ssid", SsidValue(Ssid("bss-a")));
+    auto staADev = wifiA.Install(phy, mac, staA);
+
+    // BSS colors (non-AP STAs learn them from the HE Operation element)
+    DynamicCast<WifiNetDevice>(obssApDev.Get(0))->GetHeConfiguration()->m_bssColor = 2;
+    DynamicCast<WifiNetDevice>(apADev.Get(0))->GetHeConfiguration()->m_bssColor = 1;
+
+    // high-priority EDCA for the OBSS AP: it takes the primary channel whenever it has traffic,
+    // so its occupancy is (almost) independent of BSS-A, as in the paper's evaluation
+    {
+        auto be = DynamicCast<WifiNetDevice>(obssApDev.Get(0))->GetMac()->GetQosTxop(AC_BE);
+        be->SetMinCw(obssCw, SINGLE_LINK_OP_ID);
+        be->SetMaxCw(obssCw, SINGLE_LINK_OP_ID);
+        be->SetAifsn(obssAifsn, SINGLE_LINK_OP_ID);
+    }
+
+    // OBSS AP punctures channel 44 (index 2) in its data PPDUs with probability ppunc
+    auto obssEht = DynamicCast<WifiNetDevice>(obssApDev.Get(0))->GetEhtConfiguration();
+    obssEht->SetAttribute("NonOfdmaPuncturingBitmap", UintegerValue(0b0100));
+    obssEht->SetAttribute("NonOfdmaPuncturingProbability", DoubleValue(ppunc));
+
+    // NPCA on BSS-A (AP and STAs). The AP advertises its parameters; STAs follow them.
+    if (scheme != "legacy")
+    {
+        NS_ABORT_MSG_IF(scheme != "standard" && scheme != "pa", "unknown scheme " << scheme);
+        NetDeviceContainer bssA(apADev, staADev);
+        for (uint32_t i = 0; i < bssA.GetN(); ++i)
+        {
+            auto dev = DynamicCast<WifiNetDevice>(bssA.Get(i));
+            auto npca = CreateObject<NpcaManager>();
+            npca->SetAttribute("PunctureAware", BooleanValue(scheme == "pa"));
+            npca->SetAttribute("NpcaPrimaryChannel", UintegerValue(2));
+            dev->GetMac()->SetNpcaManager(npca);
+            if (i == 0)
+            {
+                g_apNpca = npca;
+                npca->TraceConnectWithoutContext("NpcaStart", MakeCallback(&NpcaStart));
+            }
+        }
+    }
+
+    MobilityHelper mobility;
+    auto pos = CreateObject<ListPositionAllocator>();
+    const double d = distance;
+    pos->Add(Vector(0, 0, 0)); // OBSS AP
+    pos->Add(Vector(2, 0, 0)); // OBSS STA
+    pos->Add(Vector(d, 0, 0)); // BSS-A AP
+    for (uint32_t i = 0; i < nSta; ++i)
+    {
+        const double angle = 2 * M_PI * i / std::max<uint32_t>(nSta, 1);
+        pos->Add(Vector(d + 1.5 * std::cos(angle), 1.5 * std::sin(angle), 0));
+    }
+    mobility.SetPositionAllocator(pos);
+    mobility.SetMobilityModel("ns3::ConstantPositionMobilityModel");
+    mobility.Install(NodeContainer(obssAp, obssSta, apA, staA));
+
+    int64_t stream = 100;
+    NetDeviceContainer allDevs(obssApDev, obssStaDev);
+    allDevs.Add(apADev);
+    allDevs.Add(staADev);
+    stream += WifiHelper::AssignStreams(allDevs, stream);
+    obssEht->m_puncturingRv->SetStream(stream++);
+
+    // traffic
+    auto gap = CreateObject<ExponentialRandomVariable>();
+    gap->SetAttribute("Mean", DoubleValue(obssGapUs));
+    gap->SetStream(stream++);
+    Simulator::Schedule(Seconds(0.3),
+                        &ObssBurst,
+                        obssApDev.Get(0),
+                        obssStaDev.Get(0)->GetAddress(),
+                        obssBurst,
+                        gap);
+    for (uint32_t i = 0; i < nSta; ++i)
+    {
+        Simulator::Schedule(Seconds(0.3) + MicroSeconds(10 * i),
+                            &Refill,
+                            staADev.Get(i),
+                            apADev.Get(0)->GetAddress(),
+                            40,
+                            MilliSeconds(2));
+    }
+
+    DynamicCast<WifiNetDevice>(apADev.Get(0))
+        ->GetMac()
+        ->TraceConnectWithoutContext("MacRx", MakeCallback(&BssARx));
+    DynamicCast<WifiNetDevice>(obssStaDev.Get(0))
+        ->GetMac()
+        ->TraceConnectWithoutContext("MacRx", MakeCallback(&ObssRx));
+    DynamicCast<WifiNetDevice>(obssApDev.Get(0))
+        ->GetPhy()
+        ->TraceConnectWithoutContext("PhyTxPsduBegin", MakeCallback(&ObssPhyTx));
+
+    bool debug = false;
+    if (getenv("NPCA_DEBUG"))
+    {
+        debug = true;
+        auto p = DynamicCast<WifiNetDevice>(obssStaDev.Get(0))->GetPhy();
+        p->GetState()->TraceConnectWithoutContext("RxError", MakeCallback(&ObssStaRxError));
+        p->GetState()->TraceConnectWithoutContext("RxOk", MakeCallback(&ObssStaRxOk));
+        p->TraceConnectWithoutContext("PhyRxDrop", MakeCallback(&ObssStaRxDrop));
+        auto staMac = DynamicCast<WifiNetDevice>(staADev.Get(0))->GetMac();
+        g_sta0Npca = staMac->GetNpcaManager();
+        staMac->GetWifiPhy()->TraceConnectWithoutContext("PhyTxPsduBegin", MakeCallback(&Sta0Tx));
+        auto apPhy = DynamicCast<WifiNetDevice>(apADev.Get(0))->GetPhy();
+        apPhy->TraceConnectWithoutContext("MonitorSnifferRx", MakeCallback(&ApSniff));
+        apPhy->TraceConnectWithoutContext("PhyTxPsduBegin", MakeCallback(&ApTx));
+        staMac->GetWifiPhy()->TraceConnectWithoutContext("MonitorSnifferRx",
+                                                         MakeCallback(&StaSniff));
+        staMac->GetWifiPhy()->TraceConnectWithoutContext("PhyRxDrop", MakeCallback(&StaRxDrop));
+    }
+
+    Simulator::Stop(Seconds(simTime));
+    Simulator::Run();
+
+    const double dur = simTime - warmup;
+    if (header)
+    {
+        std::cout << "scheme,ppunc,run,bssA_Mbps,bssA_npca_Mbps,obss_Mbps,npca_starts,"
+                     "obss_ppdus,obss_punctured,ap_rejections\n";
+    }
+    std::string rej;
+    if (g_apNpca)
+    {
+        for (const auto& [r, c] : g_apNpca->GetRejections())
+        {
+            rej += r + "=" + std::to_string(c) + ";";
+        }
+    }
+    std::cout << std::fixed << std::setprecision(3) << scheme << "," << ppunc << "," << run << ","
+              << g_bssARxBytes * 8 / dur / 1e6 << "," << g_bssARxNpcaBytes * 8 / dur / 1e6 << ","
+              << g_obssRxBytes * 8 / dur / 1e6 << "," << g_npcaStarts << "," << g_obssPpdus << ","
+              << g_obssPunctured << ",\"" << rej << "\"\n";
+    if (debug)
+    {
+        for (const auto& [k, v] : g_debug)
+        {
+            std::cerr << k << ": " << v << "\n";
+        }
+    }
+    g_apNpca = nullptr;
+    g_sta0Npca = nullptr;
+    Simulator::Destroy();
+    return 0;
+}
diff --git a/src/npca/examples/npca-wifi-rxvector.cc b/src/npca/examples/npca-wifi-rxvector.cc
new file mode 100644
index 0000000..54e1a8b
--- /dev/null
+++ b/src/npca/examples/npca-wifi-rxvector.cc
@@ -0,0 +1,250 @@
+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ *
+ * Bridges the ns-3 Wi-Fi model and puncture-aware NPCA.
+ *
+ * Algorithm 1 reads two RXVECTOR parameters of the causal inter-BSS PPDU:
+ * CH_BANDWIDTH (WifiTxVector::GetChannelWidth) and INACTIVE_SUBCHANNELS
+ * (WifiTxVector::GetInactiveSubchannels). NpcaFromRxVector() maps them to the nominal
+ * set N and the punctured set P in the 20 MHz unit indexing of the observing BSS.
+ *
+ * Part 1 feeds hand-built EHT RXVECTORs (with puncturing) through the adapter.
+ * Part 2 runs a real ns-3 EHT scenario on 80 MHz channel 42: an OBSS STA sends frames to
+ * its AP, and the MonitorSnifferRx trace of BSS-A's AP runs Algorithm 1 on every inter-BSS
+ * PPDU it decodes, for standard and puncture-aware NPCA.
+ *
+ *   ./ns3 run "npca-wifi-rxvector --simTime=2"
+ */
+
+#include "ns3/core-module.h"
+#include "ns3/mobility-module.h"
+#include "ns3/network-module.h"
+#include "ns3/npca-module.h"
+#include "ns3/wifi-module.h"
+
+#include <iomanip>
+#include <iostream>
+#include <map>
+
+using namespace ns3;
+
+NS_LOG_COMPONENT_DEFINE("NpcaWifiRxVector");
+
+/**
+ * Map the RXVECTOR of a received PPDU to N and P in BSS-A's unit indexing.
+ *
+ * Units are numbered in increasing frequency over BSS-A's operating channel. The causal
+ * PPDU contains BSS-A's primary 20 MHz channel and, as all 802.11 channels, is aligned, so
+ * it spans the aligned block of its width that contains that primary.
+ *
+ * @param rx the RXVECTOR
+ * @param bssUnits width of BSS-A's channel in 20 MHz units
+ * @param primary20Index index of BSS-A's primary 20 MHz within its channel
+ * @return the causal PPDU description used by NpcaChannelSelector
+ */
+NpcaCausalPpdu
+NpcaFromRxVector(const WifiTxVector& rx, uint8_t bssUnits, uint8_t primary20Index)
+{
+    NpcaCausalPpdu ppdu;
+    auto w = static_cast<uint8_t>(std::max<double>(1.0, rx.GetChannelWidth() / 20.0));
+    w = std::min(w, bssUnits);
+    uint8_t base = (primary20Index / w) * w;
+    ppdu.nominal = NpcaChannelSets::Range(base, w);
+    const auto& inactive = rx.GetInactiveSubchannels();
+    for (size_t i = 0; i < inactive.size() && i < w; ++i)
+    {
+        if (inactive[i])
+        {
+            ppdu.punctured |= NpcaChannelSets::Range(base + i, 1);
+        }
+    }
+    ppdu.ofdma = rx.IsMu();
+    // a station operating on the full BSS channel receives every segment's preamble
+    ppdu.verifiedSegments = ~0U;
+    return ppdu;
+}
+
+namespace
+{
+
+Ptr<NpcaChannelSelector> g_std;  //!< standard NPCA
+Ptr<NpcaChannelSelector> g_pa;   //!< puncture-aware NPCA
+Mac48Address g_bssA;             //!< BSS-A BSSID
+uint8_t g_units = 4;             //!< BSS-A width in units
+uint8_t g_p20 = 0;               //!< BSS-A primary 20 index
+std::map<std::string, uint32_t> g_counts; //!< statistics
+
+void
+Report(const std::string& label, const NpcaCausalPpdu& ppdu, UnitSet idle)
+{
+    auto s = g_std->Select(ppdu, idle);
+    auto p = g_pa->Select(ppdu, idle);
+    std::cout << std::left << std::setw(40) << label << " N=" << std::setw(12)
+              << NpcaChannelSets::ToString(ppdu.nominal) << " P=" << std::setw(6)
+              << NpcaChannelSets::ToString(ppdu.punctured) << " standard C=" << std::setw(8)
+              << NpcaChannelSets::ToString(s.channel) << " PA C=" << NpcaChannelSets::ToString(p.channel)
+              << "\n";
+}
+
+void
+SnifferRx(Ptr<const Packet> packet,
+          uint16_t /* channelFreqMhz */,
+          WifiTxVector txVector,
+          MpduInfo /* aMpdu */,
+          SignalNoiseDbm /* signalNoise */,
+          uint16_t /* staId */)
+{
+    WifiMacHeader hdr;
+    packet->PeekHeader(hdr);
+    // inter-BSS classification (simplified): no address field equals BSS-A's BSSID
+    bool intra = (hdr.GetAddr1() == g_bssA) ||
+                 ((hdr.IsData() || hdr.IsMgt()) &&
+                  (hdr.GetAddr2() == g_bssA || hdr.GetAddr3() == g_bssA));
+    if (intra)
+    {
+        return;
+    }
+    NpcaCausalPpdu ppdu = NpcaFromRxVector(txVector, g_units, g_p20);
+    // per-unit CCA: everything outside the occupied set is idle in this scenario
+    UnitSet idle = NpcaChannelSets::Range(0, g_units) & ~(ppdu.nominal & ~ppdu.punctured);
+    auto s = g_std->Select(ppdu, idle);
+    auto p = g_pa->Select(ppdu, idle);
+    g_counts["inter-BSS PPDUs"]++;
+    g_counts["CH_BANDWIDTH " + std::to_string(static_cast<int>(txVector.GetChannelWidth())) +
+             " MHz"]++;
+    if (s.IsUsable())
+    {
+        g_counts["eligible: standard NPCA"]++;
+    }
+    if (p.IsUsable())
+    {
+        g_counts["eligible: PA-NPCA"]++;
+    }
+}
+
+} // namespace
+
+int
+main(int argc, char* argv[])
+{
+    double simTime = 2.0;
+    CommandLine cmd(__FILE__);
+    cmd.AddValue("simTime", "Simulated seconds for the live part", simTime);
+    cmd.Parse(argc, argv);
+
+    // ---- Part 1: synthetic EHT RXVECTORs through the adapter (Fig. 1 and 160 MHz cases)
+    std::cout << "Part 1: RXVECTOR -> (N, P) -> Algorithm 1\n";
+    {
+        g_std = CreateObject<NpcaChannelSelector>();
+        g_pa = CreateObject<NpcaChannelSelector>();
+        g_std->SetScheme(NpcaScheme::STANDARD);
+        g_pa->SetScheme(NpcaScheme::PUNCTURE_AWARE);
+        for (auto sel : {g_std, g_pa})
+        {
+            sel->SetAttribute("BssUnits", UintegerValue(4));
+            sel->SetAttribute("NpcaPrimary", IntegerValue(2));
+        }
+        WifiTxVector rx;
+        rx.SetPreambleType(WIFI_PREAMBLE_EHT_MU);
+        rx.SetChannelWidth(MHz_u{80});
+        Report("80 MHz EHT PPDU, unpunctured", NpcaFromRxVector(rx, 4, 0), 0);
+        rx.SetInactiveSubchannels({false, false, true, false});
+        Report("80 MHz EHT PPDU, ch2 punctured (Fig 1)",
+               NpcaFromRxVector(rx, 4, 0),
+               NpcaChannelSets::Range(2, 1));
+        rx.SetInactiveSubchannels({false, false, false, true});
+        Report("80 MHz EHT PPDU, ch3 punctured",
+               NpcaFromRxVector(rx, 4, 0),
+               NpcaChannelSets::Range(3, 1));
+        WifiTxVector rx40;
+        rx40.SetPreambleType(WIFI_PREAMBLE_EHT_MU);
+        rx40.SetChannelWidth(MHz_u{40});
+        Report("40 MHz EHT PPDU", NpcaFromRxVector(rx40, 4, 0), NpcaChannelSets::Range(2, 2));
+
+        for (auto sel : {g_std, g_pa})
+        {
+            sel->SetAttribute("BssUnits", UintegerValue(16));
+            sel->SetAttribute("NpcaPrimary", IntegerValue(8));
+        }
+        WifiTxVector rx160;
+        rx160.SetPreambleType(WIFI_PREAMBLE_EHT_MU);
+        rx160.SetChannelWidth(MHz_u{160});
+        rx160.SetInactiveSubchannels({false, false, false, false, false, false, true, true});
+        Report("160 MHz PPDU in 320 MHz BSS, 40 hole",
+               NpcaFromRxVector(rx160, 16, 0),
+               NpcaChannelSets::Range(6, 10));
+    }
+
+    // ---- Part 2: live ns-3 EHT scenario, Algorithm 1 driven by MonitorSnifferRx
+    std::cout << "\nPart 2: live EHT OBSS on channel 42 (80 MHz), observed by BSS-A's AP\n";
+    NodeContainer obssAp(1);
+    NodeContainer obssSta(1);
+    NodeContainer bssAAp(1);
+
+    auto channel = YansWifiChannelHelper::Default();
+    YansWifiPhyHelper phy;
+    phy.SetChannel(channel.Create());
+    phy.Set("ChannelSettings", StringValue("{42, 80, BAND_5GHZ, 0}"));
+
+    WifiHelper wifi;
+    wifi.SetStandard(WIFI_STANDARD_80211be);
+    wifi.SetRemoteStationManager("ns3::ConstantRateWifiManager",
+                                 "DataMode",
+                                 StringValue("EhtMcs7"),
+                                 "ControlMode",
+                                 StringValue("OfdmRate24Mbps"));
+    WifiMacHelper mac;
+    mac.SetType("ns3::ApWifiMac", "Ssid", SsidValue(Ssid("obss")));
+    auto obssApDev = wifi.Install(phy, mac, obssAp);
+    mac.SetType("ns3::StaWifiMac", "Ssid", SsidValue(Ssid("obss")));
+    auto obssStaDev = wifi.Install(phy, mac, obssSta);
+    mac.SetType("ns3::ApWifiMac", "Ssid", SsidValue(Ssid("bss-a")));
+    auto bssADev = wifi.Install(phy, mac, bssAAp);
+
+    MobilityHelper mobility;
+    auto pos = CreateObject<ListPositionAllocator>();
+    pos->Add(Vector(0, 0, 0));
+    pos->Add(Vector(5, 0, 0));
+    pos->Add(Vector(0, 5, 0));
+    mobility.SetPositionAllocator(pos);
+    mobility.SetMobilityModel("ns3::ConstantPositionMobilityModel");
+    mobility.Install(NodeContainer(obssAp, obssSta, bssAAp));
+
+    auto bssAWifi = DynamicCast<WifiNetDevice>(bssADev.Get(0));
+    g_bssA = Mac48Address::ConvertFrom(bssAWifi->GetAddress());
+    auto bssAPhy = bssAWifi->GetPhy();
+    g_units = static_cast<uint8_t>(bssAPhy->GetChannelWidth() / 20);
+    g_p20 = bssAPhy->GetOperatingChannel().GetPrimaryChannelIndex(MHz_u{20});
+    for (auto sel : {g_std, g_pa})
+    {
+        sel->SetAttribute("BssUnits", UintegerValue(g_units));
+        sel->SetAttribute("PrimaryUnit", UintegerValue(g_p20));
+        sel->SetAttribute("NpcaPrimary", IntegerValue(2));
+    }
+    bssAPhy->TraceConnectWithoutContext("MonitorSnifferRx", MakeCallback(&SnifferRx));
+
+    // OBSS STA -> OBSS AP traffic without an IP stack
+    auto staDev = obssStaDev.Get(0);
+    Address apAddr = obssApDev.Get(0)->GetAddress();
+    for (double t = 0.5; t < simTime; t += 0.002)
+    {
+        Simulator::Schedule(Seconds(t), [staDev, apAddr]() {
+            staDev->Send(Create<Packet>(1200), apAddr, 0x0800);
+        });
+    }
+
+    Simulator::Stop(Seconds(simTime));
+    Simulator::Run();
+    std::cout << "BSS-A: " << +g_units << " units, primary20 index " << +g_p20
+              << ", NPCA primary unit 2\n";
+    for (const auto& [k, v] : g_counts)
+    {
+        std::cout << "  " << std::left << std::setw(32) << k << v << "\n";
+    }
+    std::cout << "(ns-3 transmits SU PPDUs unpunctured, so the live counts match; Part 1 shows\n"
+                 " the difference once INACTIVE_SUBCHANNELS is signalled.)\n";
+    Simulator::Destroy();
+    return 0;
+}
