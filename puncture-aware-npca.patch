+std::vector<bool>
+EhtPpdu::GetInactiveSubchannelsFromPuncturedInfo(uint8_t puncturedInfo, MHz_u channelWidth)
+{
+    const auto n = static_cast<std::size_t>(channelWidth / MHz_u{20});
+    std::vector<bool> inactive(n, false);
+    if (puncturedInfo >= 1 && puncturedInfo <= 8 && puncturedInfo <= n)
+    {
+        inactive.at(puncturedInfo - 1) = true; // one 20 MHz subchannel
+    }
+    else if (puncturedInfo >= 9 && puncturedInfo <= 12 && 2 * (puncturedInfo - 9) + 1 < n)
+    {
+        inactive.at(2 * (puncturedInfo - 9)) = true; // one aligned 40 MHz subchannel
+        inactive.at(2 * (puncturedInfo - 9) + 1) = true;
+    }
+    return inactive;
+}
