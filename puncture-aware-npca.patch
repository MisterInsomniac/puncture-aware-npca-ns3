+
+void
+Txop::RestoreNpcaBackoff(uint8_t linkId)
+{
+    NS_LOG_FUNCTION(this << +linkId);
+    auto& link = GetLink(linkId);
+    if (!link.npcaInitialQsrc.has_value())
+    {
+        return;
+    }
+    link.npcaInitialQsrc.reset();
+    link.cw = link.npcaSavedCw;
+    link.staRetryCount = link.npcaSavedQsrc;
+    m_cwTrace(link.cw, linkId);
+    StartBackoffNow(link.npcaSavedBackoffSlots, linkId);
+}
+
+bool
+Txop::IsOnNpcaChannel(uint8_t linkId) const
+{
+    return GetLink(linkId).npcaInitialQsrc.has_value();
+}
