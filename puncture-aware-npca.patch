+void
+NpcaManager::DoInitialize()
+{
+    NS_LOG_FUNCTION(this);
+    NS_ABORT_MSG_IF(!m_mac, "NpcaManager: SetWifiMac() not called");
+    NS_ABORT_MSG_IF(m_mac->GetNLinks() != 1, "NpcaManager supports single-link devices only");
+    auto phy = m_mac->GetWifiPhy(SINGLE_LINK_OP_ID);
+    NS_ABORT_MSG_IF(!phy, "NpcaManager: no PHY");
+    m_bssPrimary = phy->GetOperatingChannel().GetPrimaryChannelIndex(MHz_u{20});
+    for (auto mc : {WIFI_MOD_CLASS_HE, WIFI_MOD_CLASS_EHT})
+    {
+        if (phy->GetMaxModulationClassSupported() >= mc)
+        {
+            auto hePhy = std::dynamic_pointer_cast<HePhy>(phy->GetPhyEntity(mc));
+            NS_ASSERT(hePhy);
+            hePhy->SetNpcaPreambleCallback(MakeCallback(&NpcaManager::NotifyPreamble, this));
+        }
+    }
+    Object::DoInitialize();
+}
