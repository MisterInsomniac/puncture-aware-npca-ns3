+/*
+ * Copyright (c) 2026
+ *
+ * SPDX-License-Identifier: GPL-2.0-only
+ */
+
+#include "npca-analytical-model.h"
+
+#include <cmath>
+
+namespace ns3
+{
+
+double
+NpcaAnalyticalModel::Term(UnitSet a, const Params& p, Variant v)
+{
+    double t = 0;
+    switch (v)
+    {
+    case UNCONSTRAINED:
+        t = NpcaChannelSets::Count(a);
+        break;
+    case FLEXIBLE:
+        t = NpcaChannelSets::Count(NpcaChannelSets::LargestCompliantSet(a, -1, p.bssUnits));
+        break;
+    default:
+        t = NpcaChannelSets::Count(
+            NpcaChannelSets::LargestCompliantSet(a, p.npcaPrimary, p.bssUnits));
+    }
+    if (!p.weighted)
+    {
+        return t > 0 ? 1.0 : 0.0;
+    }
+    return t;
+}
+
+double
+NpcaAnalyticalModel::ExpectedUnits(const Params& p, Variant v)
+{
+    const UnitSet bss = NpcaChannelSets::Range(0, p.bssUnits);
+    const double full = p.weighted ? p.bssUnits : 1.0;
+    double busy = 0;
+    for (const auto& [w, pw] : p.widthDist)
+    {
+        const UnitSet aw = bss & ~NpcaChannelSets::Range(0, w);
+        const double base = Term(aw, p, v);
+        if (v == STANDARD || w < 4)
+        {
+            busy += pw * base;
+            continue;
+        }
+        std::vector<PuncturingPattern> patterns;
+        if (p.targetedUnit >= 0)
+        {
+            if (w == 4)
+            {
+                UnitSet b = NpcaChannelSets::Range(p.targetedUnit, 1);
+                patterns.push_back({b, {b}});
+            }
+        }
+        else
+        {
+            patterns = NpcaChannelSets::GetPuncturingPatterns(w, 0, 0);
+        }
+        if (patterns.empty())
+        {
+            busy += pw * base;
+            continue;
+        }
+        double punct = 0;
+        for (const auto& phi : patterns)
+        {
+            const auto nb = phi.blocks.size();
+            for (uint32_t mask = 0; mask < (1U << nb); ++mask) // B subset of phi
+            {
+                UnitSet b = 0;
+                int idle = 0;
+                for (size_t i = 0; i < nb; ++i)
+                {
+                    if ((mask >> i) & 1U)
+                    {
+                        b |= phi.blocks[i];
+                        ++idle;
+                    }
+                }
+                double prob = std::pow(p.q, idle) * std::pow(1.0 - p.q, static_cast<int>(nb) - idle);
+                punct += prob * Term(aw | b, p, v);
+            }
+        }
+        busy += pw * ((1.0 - p.pi) * base + p.pi * punct / patterns.size());
+    }
+    return (1.0 - p.rho) * full + p.rho * busy;
+}
+
+double
+NpcaAnalyticalModel::GainOverStandard(const Params& p, Variant v)
+{
+    return ExpectedUnits(p, v) / ExpectedUnits(p, STANDARD) - 1.0;
+}
+
+double
+NpcaAnalyticalModel::BaseGain(double rho, double ppunc, double q)
+{
+    return 0.6 * rho * ppunc * q / ((1.0 - rho) + 0.4 * rho);
+}
+
+} // namespace ns3
